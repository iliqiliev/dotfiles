{{- $name := "" }}
{{- $email := "" }}
{{- $username := "" }}
{{- if regexMatch "iliq|iliya" .chezmoi.username }}
    {{- $name = "Iliya Iliev" }}
    {{- $email = "iliq0000@proton.me" }}
    {{- $username = "iliqiliev" }}
{{- else }}
    {{- $name = promptStringOnce . "name" "Full name (for git)" }}
