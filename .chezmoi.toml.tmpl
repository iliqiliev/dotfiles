{{- $name := "" }}
{{- $email := "" }}
{{- $username := "" }}
{{- $distro := "" }}
{{- $sudo := "" -}}

{{- if regexMatch "iliq|iliya" .chezmoi.username }}
    {{- $name = "Iliya Iliev" }}
    {{- $email = "iliq0000@proton.me" }}
    {{- $username = "iliqiliev" }}
{{- else }}
    {{- $name = promptStringOnce . "name" "Full name (for git)" }}
    {{- $email = promptStringOnce . "email" "Email address (for git)" }}
    {{- $username = promptStringOnce . "username" "Username (for git)" }}
{{- end -}}

{{- if hasKey .chezmoi.osRelease "idLike" }}
	{{- $distro = splitList " " .chezmoi.osRelease.idLike | last }}
{{- else if hasKey .chezmoi.osRelease "id" }}
    {{- $distro = .chezmoi.osRelease.id }}
{{- else if hasKey .chezmoi "os" }}
    {{- $distro = .chezmoi.os }}
{{- else }}
    {{- $distro = "unknown" }}
{{- end -}}

{{- if or (eq .chezmoi.uid "0") (eq .distro "android") }}
    {{- $sudo = "" }}
{{- else if lookPath "doas"}}
    {{- $sudo = "doas" }}
{{- else if lookPath "gsudo"}}
    {{- $sudo = "gsudo" }}
{{- else if lookPath "sudo"}}
    {{- $sudo = "sudo" }}
{{- else }}
    {{- $sudo = "su root -c" }}
{{- end -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    username = {{ $username | quote }}
    distro = {{ $distro | lower | quote }}
    sudo = {{ $sudo | quote }}
