{{- $distro := "" }}
{{- if hasKey .chezmoi.osRelease "idLike" }}
{{-   $distro = splitList " " .chezmoi.osRelease.idLike | last }}
{{- else if hasKey .chezmoi.osRelease "id" }}
{{-   $distro = .chezmoi.osRelease.id }}
{{- else if hasKey .chezmoi "os" }}
{{-   $distro = .chezmoi.os }}
{{- end }}

{{- $isPersonal := promptBoolOnce . "isPersonal" "Are you a Iliya Iliev" false }}
{{- $installGui := promptBoolOnce . "installGui" "Install GUI applications" false }}
{{- $isKvmGuest := false }}
{{- if exec "systemd-detect-virt" "--vm" }}
{{-   $isKvmGuest = eq (output "systemd-detect-virt" "--vm" | trim) "kvm" }}
{{- end }}

{{- $name := "Iliya Iliev" }}
{{- $email := "iliq0000@proton.me" }}
{{- if not $isPersonal }}
{{-   $email = promptStringOnce . "email" "Email (for git)" "" | quote }}
{{-   $name = promptStringOnce . "name" "Name (for git)" (splitList "@" $email | first) | quote }}
{{- end }}

{{- $os := "" }}
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") }}
{{-   $os = "linux" }}
{{- else if hasKey .chezmoi "os" }}
{{-   $os = .chezmoi.os }}
{{- end }}

{{- $sudo := "su root -c" }}
{{- if or (eq .chezmoi.uid "0") (eq $distro "android") }}
{{-   $sudo = "" }}
{{- else if lookPath "doas"}}
{{-   $sudo = "doas" }}
{{- else if lookPath "gsudo"}}
{{-   $sudo = "gsudo" }}
{{- else if lookPath "sudo"}}
{{-   $sudo = "sudo" }}
{{- end -}}

[data]
distro = {{ $distro | lower | quote }}
os = {{ $os | lower | quote }}

isPersonal = {{ $isPersonal }}
installGui= {{ $installGui }}
isKvmGuest = {{ $isKvmGuest }}

name = {{ $name | quote }}
email = {{ $email | quote }}

{{- if lookPath "delta" }}

[diff]
pager = "delta"

{{- end }}

[env]
RED    = '\033[31m'
GREEN  = '\033[32m'
YELLOW = '\033[33m'
BLUE   = '\033[34m'
NORMAL = '\033[0m'

CHEZ_DISTRO = {{ $distro | quote }}
CHEZ_SUDO = {{ $sudo | quote }}

BASH_ENV = "$HOME/.config/bash/bash_env"

{{- $localBin := joinPath .chezmoi.homeDir ".local" "bin" }}
{{- if not (has $localBin (splitList .chezmoi.pathListSeparator (env "PATH"))) }}
PATH = {{ join .chezmoi.pathListSeparator (list $localBin (env "PATH")) | quote }}
{{ end }}

[interpreters.fish]
command = "fish"

[interpreters.sh]
command = "bash"
args = ["-eu"]
