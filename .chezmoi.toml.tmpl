{{- $name := "Iliya Iliev" }}
{{- $email := "iliq0000@proton.me" }}
{{- $os := "" }}
{{- $distro := "" }}
{{- $sudo := "su root -c" }}
{{- $isKvmGuest := false }}
{{- $verticalResolution := 0 }}
{{- $pathList := (splitList .chezmoi.pathListSeparator (env "PATH")) }}
{{- $localBin := joinPath .chezmoi.homeDir ".local" "bin" }}
{{- $fontsDir := ".local/share/fonts" }}
{{- $fontSizeSmall := 12 }}
{{- $fontSizeMedium := 16 }}
{{- $fontSizeBig := 20 }}


{{- $isPersonal := promptBoolOnce . "isPersonal" "Are you a Iliya Iliev" false }}
{{- if not $isPersonal }}
{{-   $email = promptStringOnce . "email" "Email (for git)" "" | quote }}
{{-   $name = promptStringOnce . "name" "Name (for git)" (splitList "@" $email | first) | quote }}
{{- end }}

{{- $installGui := promptBoolOnce . "installGui" "Install GUI applications" false }}
{{- if lookPath "systemd-detect-virt" }}
{{-   $isKvmGuest = eq (output "systemd-detect-virt" "--vm" | trim) "kvm" }}
{{- end }}

{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") }}
{{-   $os = "linux" }}
{{- else if hasKey .chezmoi "os" }}
{{-   $os = .chezmoi.os }}
{{- end }}

{{- if hasKey .chezmoi.osRelease "idLike" }}
{{-   $distro = splitList " " .chezmoi.osRelease.idLike | last }}
{{- else if hasKey .chezmoi.osRelease "id" }}
{{-   $distro = .chezmoi.osRelease.id }}
{{- else if hasKey .chezmoi "os" }}
{{-   $distro = .chezmoi.os }}
{{- end }}

{{- if or (eq .chezmoi.uid "0") (eq $distro "android") }}
{{-   $sudo = "" }}
{{- else if lookPath "doas"}}
{{-   $sudo = "doas" }}
{{- else if lookPath "gsudo"}}
{{-   $sudo = "gsudo" }}
{{- else if lookPath "sudo"}}
{{-   $sudo = "sudo" }}
{{- end }}

{{- if eq $os "linux" }}
{{-   $fontsDir = $fontsDir }}
{{-   $verticalResolution = output "bash" "-c"
        "grep -oP -m 1 \"(?<=,)\\d+\" /sys/class/graphics/*/virtual_size" | trim | atoi }}
{{- else if eq $os "windows" }}
{{-   $fontsDir = "AppData\\Local\\Microsoft\\Windows\\Fonts" }}
{{-   $verticalResolution = output "powershell" "-Command"
        "(gwmi Win32_VideoController).CurrentVerticalResolution" | trim | atoi }}
{{- end -}}

[data]
distro = {{ $distro | lower | quote }}
os = {{ $os | lower | quote }}

isPersonal = {{ $isPersonal }}
installGui= {{ $installGui }}
isKvmGuest = {{ $isKvmGuest }}

name = {{ $name | quote }}
email = {{ $email | quote }}

[data.fonts]
dir = {{ $fontsDir | quote }}

{{- if le $verticalResolution 800 }}
size = {{ $fontSizeSmall }}
{{- else if le $verticalResolution 1080 }}
size = {{ $fontSizeMedium }}
{{- else }}
size = {{ $fontSizeBig }}
{{- end }}

{{- if lookPath "delta" }}

[diff]
pager = "delta"

{{- end }}

[env]
RED    = '\033[31m'
GREEN  = '\033[32m'
YELLOW = '\033[33m'
BLUE   = '\033[34m'
NORMAL = '\033[0m'

CHEZ_DISTRO = {{ $distro | quote }}
CHEZ_SUDO = {{ $sudo | quote }}

BASH_ENV = "$HOME/.config/bash/bash_env"

{{- if not (has $localBin $pathList) }}
PATH = {{ join .chezmoi.pathListSeparator (append $pathList $localBin) | quote }}
{{ end }}

[interpreters.fish]
command = "fish"

[interpreters.sh]
command = "bash"
args = ["-eu"]
