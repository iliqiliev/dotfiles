<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<addon
    id="service.chezmoi.bootstrap"
    name="Chezmoi Dotfiles"
    version="1.0.0"
    provider-name="Iliya Iliev"
>
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <!-- Elementum. -->
    <import addon="plugin.video.elementum" version="0.1.114" />
    <import addon="script.elementum.burst" version="0.0.99" />
    <import addon="context.elementum" version="0.0.15" />
    <import addon="repository.elementumorg" version="0.0.7" optional="true" />
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup" />
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <website>https://github.com/iliqiliev/dotfiles</website>
    <source>https://github.com/iliqiliev/dotfiles</source>
    <summary lang="en">Chezmoi dotfiles bootstrap.</summary>
    <description lang="en">Install necessary addons on Kodi startup.</description>
  </extension>
</addon>
