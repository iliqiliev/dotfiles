# vim: filetype=py
# chezmoi:template:left-delimiter="# {{"

from pathlib import Path

from chezmoi import (
    install_missing_addons,
    kodi_configure_db_myvideos,
    kodi_log,
    kodi_set_setting,
)
from xbmcaddon import Addon
from xbmcvfs import mkdirs, translatePath

PERSONAL: bool = "# {{ .isPersonal }}" == "true"  # noqa: PLR0133
"""Chezmoi expands `isPersonal` to `true` or `false`."""


def main() -> None:
    kodi_log("Starting bootstrap ...")

    if PERSONAL:
        kodi_log("Changing locale.")
        kodi_set_setting("locale.country", "Central Europe")

        kodi_log("Setting subtitles languages.")
        kodi_set_setting("subtitles.languages", ["Bulgarian", "English"])

    kodi_log("Allowing installing addons from ZIP files.")
    kodi_set_setting("addons.unknownsources", True)

    kodi_log("Allow file deletion in file lists.")
    kodi_set_setting("filelists.allowfiledeletion", True)

    kodi_log("Setting device name.")
    kodi_set_setting("services.devicename", "# {{ .distro }}-# {{ .chezmoi.hostname }}")

    kodi_log("Disabling browsing of SMB network folders.")
    kodi_set_setting("services.wsdiscovery", False)

    kodi_log("Setting subtitles font size.")
    kodi_set_setting("subtitles.fontsize", 32)

    kodi_log("Hiding plot and episode's thumbnail for unwatched items.")
    kodi_set_setting("videolibrary.showunwatchedplots", [])

    kodi_log("Autoselecting the first unwatched item for TV shows.")
    kodi_set_setting("videolibrary.tvshowsselectfirstunwatcheditem", 2)

    kodi_log("Enabling video library update on startup.")
    kodi_set_setting("videolibrary.updateonstartup", True)

    configure_video_library()

    if not install_missing_addons():
        kodi_log("Aborting bootstrap because of missing addons.")
        return

    configure_addon_elementum()
    configure_addon_unpause_jumpback()

    kodi_log("Finished bootstrap.")


def configure_video_library() -> None:
    kodi_log("Configuring video library ...")

    db_matches = tuple(Path(translatePath("special://database")).glob("MyVideos*.db"))

    if len(db_matches) != 1:
        kodi_log(f"Expected only one MyVideos*.db file, found '{db_matches}'.")
        return

    my_videos_db = db_matches[0]
    kodi_log(f"Detected video database: '{my_videos_db}'.")

    kodi_configure_db_myvideos(
        db=my_videos_db,
        path="special://temp/elementum_library/Movies/",
        content="movies",
        scraper="metadata.themoviedb.org.python",
    )

    kodi_configure_db_myvideos(
        db=my_videos_db,
        path="special://temp/elementum_library/Shows/",
        content="tvshows",
        scraper="metadata.tvshows.themoviedb.org.python",
    )

    kodi_log("Video library configured.")


def configure_addon_elementum() -> None:
    kodi_log("Configuring Elementum ...")
    elementum = Addon("plugin.video.elementum")

    elementum_download_path = translatePath("special://envhome/Videos/Kodi/")
    kodi_log(f"Creating download path: '{elementum_download_path}'.")
    mkdirs(elementum_download_path)

    kodi_log("Setting download path.")
    elementum.setSetting("download_path", elementum_download_path)

    kodi_log("Setting storage type to files.")
    elementum.setSetting("download_storage", "0")

    kodi_log("Disabling Elementum's overlay.")
    elementum.setSetting("enable_overlay_status", "false")

    kodi_log("Disabling Elementum greeting notification.")
    elementum.setSetting("greeting_enabled", "false")

    kodi_log("Keeping downloaded files after playback.")
    # 0 - Keep; 1 - Ask; 2 - Delete.
    elementum.setSetting("keep_downloading", "0")
    elementum.setSetting("keep_files_playing", "0")
    elementum.setSetting("keep_files_finished", "0")

    kodi_log("Enabling seeding forever.")
    elementum.setSetting("seed_forever", "true")

    kodi_log("Disabling Elementum's own Burst check.")
    elementum.setSetting("skip_burst_search", "true")

    kodi_log("Do not remove items from Trakt.")
    elementum.setSetting("trakt_sync_removed_movies", "false")
    elementum.setSetting("trakt_sync_removed_shows", "false")

    kodi_log("Elementum configured.")


def configure_addon_unpause_jumpback() -> None:
    kodi_log("Configuring Unpause Jumpback ...")
    unpause_jumpback = Addon("script.xbmc.unpausejumpback")

    kodi_log("Setting jump back seconds.")
    unpause_jumpback.setSetting("jumpbacksecs", "2")

    kodi_log("Setting minimum pause duration for jump back.")
    unpause_jumpback.setSetting("waitforjumpback", "0")

    kodi_log("Unpause Jumpback configured.")


if __name__ == "__main__":
    main()
