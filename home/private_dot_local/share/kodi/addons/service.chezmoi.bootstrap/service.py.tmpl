from json import dumps as json_dumps
from json import loads as json_loads
from pathlib import Path
from sqlite3 import connect as sqlite3_connect
from typing import Literal

from xbmc import LOGDEBUG, LOGINFO, executebuiltin, executeJSONRPC, log, sleep
from xbmcaddon import Addon
from xbmcgui import DLG_YESNO_YES_BTN, Dialog
from xbmcvfs import translatePath

type KodiSettingsValue = list[str] | str | int | bool | None

ADDON = Addon()
ADDON_ID = ADDON.getAddonInfo("id")
ADDON_NAME = ADDON.getAddonInfo("name")


def main() -> None:
    kodi_log("Started.")

    kodi_log("Allowing installing addons from ZIP files.")
    set_setting("addons.unknownsources", True)

    kodi_log("Allow file deletion in file lists.")
    set_setting("filelists.allowfiledeletion", True)

    kodi_log("Changing locale.")
    set_setting("locale.country", "Central Europe")

    kodi_log("Setting device name.")
    set_setting("services.devicename", "# {{ .distro }}-# {{ .chezmoi.hostname }}")

    kodi_log("Disabling browsing of SMB network folders.")
    set_setting("services.wsdiscovery", False)

    kodi_log("Autoselecting the first unwatched item for TV shows.")
    set_setting("videolibrary.tvshowsselectfirstunwatcheditem", 2)

    kodi_log("Hiding plot and episode's thumbnail for unwatched items.")
    set_setting("videolibrary.showunwatchedplots", None)

    kodi_log("Checking for missing 3-rd party addons ...")
    if not handle_missing_addons():
        kodi_log("Aborting.")
        return

    kodi_log("Configuring Elementum ...")
    configure_elementum()

    kodi_log("Configuring video library ...")
    configure_video_library()

    kodi_log("Finished.")


def configure_video_library() -> None:
    db_matches = tuple(Path(translatePath("special://database")).glob("MyVideos*.db"))

    if len(db_matches) != 1:
        kodi_log(f"Expected only one MyVideos*.db file, found '{db_matches}'.")
        return

    my_videos_db = db_matches[0]
    kodi_log(f"Detected video database: '{my_videos_db}'.")

    set_video_library_content(
        db=my_videos_db,
        path="special://temp/elementum_library/Movies/",
        content="movies",
        scraper="metadata.themoviedb.org.python",
    )

    set_video_library_content(
        db=my_videos_db,
        path="special://temp/elementum_library/Shows/",
        content="tvshows",
        scraper="metadata.tvshows.themoviedb.org.python",
    )

    kodi_log("Video library configured.")


def configure_elementum() -> None:
    elementum = Addon("plugin.video.elementum")

    kodi_log("Setting storage type to files.")
    elementum.setSetting("download_storage", "0")
    elementum_download_path = Path.home() / "Videos/Kodi"
    kodi_log(f"Creating download path: '{elementum_download_path}'.")
    elementum_download_path.mkdir(parents=True, exist_ok=True)
    kodi_log("Setting download path.")
    elementum.setSetting("download_path", f"{elementum_download_path}/")
    kodi_log("Enabling seeding forever.")
    elementum.setSetting("seed_forever", "true")

    kodi_log("Elementum configured.")


def get_addon_dependencies(addon_id: str) -> set[str]:
    rpc_response = json_rpc(
        method="Addons.GetAddonDetails",
        params={"addonid": addon_id, "properties": ["dependencies"]},
    )
    response_dict = json_loads(rpc_response)

    dependencies: set[str] = {
        dependency["addonid"]
        for dependency in response_dict["result"]["addon"]["dependencies"]
    }
    dependencies.discard("xbmc.python")

    return dependencies


def get_installed_addons() -> set[str]:
    rpc_response = json_rpc(method="Addons.GetAddons", params={})
    kodi_log(f"get_installed_addons: rpc_response={rpc_response}", LOGDEBUG)
    response_dict = json_loads(rpc_response)
    return {addon["addonid"] for addon in response_dict["result"]["addons"]}


def get_missing_addons() -> set[str]:
    return get_addon_dependencies(ADDON_ID) - get_installed_addons()


def handle_missing_addons() -> bool:
    while missing_addons := get_addon_dependencies(ADDON_ID) - get_installed_addons():
        kodi_log(f"Missing addon: '{' '.join(missing_addons)}'.")

        if not Dialog().yesno(
            heading=ADDON_NAME,
            message=(
                "The following addons are missing:"
                f"\n{'\n'.join(missing_addons)}"
                "\nDo you want to install them now?"
                "\n(look in 'Chezmoi' in the file picker)"
            ),
            defaultbutton=DLG_YESNO_YES_BTN,
        ):
            kodi_log("Skipping file picker.")
            return False

        kodi_log("Opening file picker ...")
        executebuiltin("InstallFromZip", wait=True)
        kodi_log("File picker closed.")
        # Sleep to allow the addon to be installed correctly so that
        # the next iteration can properly detect it as installed.
        sleep(1000)

    kodi_log("No missing addon dependencies.")
    return True


def json_rpc(method: str, params: dict[str, KodiSettingsValue]) -> str:
    payload = json_dumps(
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": method,
            "params": params,
        }
    )

    return executeJSONRPC(payload)


def kodi_log(message: str, level: int = LOGINFO) -> None:
    log(f"[{ADDON_ID}] {message}", level)


def set_setting(key: str, value: KodiSettingsValue) -> None:
    json_rpc(
        method="Settings.SetSettingValue",
        params={"setting": key, "value": value},
    )


def set_video_library_content(
    db: Path,
    path: str,
    content: Literal["movies", "tvshows"],
    scraper: str,
) -> None:

    parameters = {
        "strPath": path,
        "strContent": content,
        "strScraper": scraper,
        "scanRecursive": 2**31 - 1,  # Kodi sets this value by default.
    }

    kodi_log(f"Configuring '{path}' in database '{db}' ...")

    with sqlite3_connect(db, autocommit=True) as connection:
        existing = connection.execute(  # sql
            "SELECT idPath FROM path WHERE strPath == :strPath;",
            parameters,
        )

        if existing.fetchone() is not None:
            kodi_log(f"Library '{path}' is already configured. Skipping it.")
            return

        connection.execute(  # sql
            """INSERT INTO path (strPath, strContent, strScraper, scanRecursive)
               VALUES (:strPath, :strContent, :strScraper, :scanRecursive);""",
            parameters,
        )


if __name__ == "__main__":
    main()
