{{ if not .manageGui -}}
{{   abortEmpty -}}
{{ end -}}

{{ $fontsPath := ".local/share/fonts" -}}

{{ if eq .os "windows" -}}
{{   $fontsPath = "AppData/Local/Microsoft/Windows/Fonts" -}}
{{ end -}}

{{ $nerdFontsTag := "v3.5.1" -}}

["AdwaitaMono"]
targetPath = "{{ $fontsPath }}"
type = "archive"
include = ["*NerdFontMono-*.ttf"]
checksum.sha256 = "409118887ec166a2342c184ade6734faf5d236a097742cb7085ff42826a1dd94"
urls = [
  "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ $nerdFontsTag }}/AdwaitaMono.tar.xz",
  "https://sourceforge.net/projects/nerd-fonts.mirror/files/{{ $nerdFontsTag }}/AdwaitaMono.tar.xz",
]

["UbuntuMono"]
targetPath = "{{ $fontsPath }}"
type = "archive"
include = ["*NerdFontMono-*.ttf"]
checksum.sha256 = "9c4d18e23e1ff809849fa0afec79ade67c58e22150c95ea373d22598c1ddea18"
urls = [
  "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ $nerdFontsTag }}/UbuntuMono.tar.xz",
  "https://sourceforge.net/projects/nerd-fonts.mirror/files/{{ $nerdFontsTag }}/UbuntuMono.tar.xz",
]
