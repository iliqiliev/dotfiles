{{ if not .manageGui -}}
{{   abortEmpty -}}
{{ end -}}

{{ $fontsPath := ".local/share/fonts" -}}

{{ if eq .os "windows" -}}
{{   $fontsPath = "AppData/Local/Microsoft/Windows/Fonts" -}}
{{ end -}}

["AdwaitaMono"]
targetPath = "{{ $fontsPath }}"
type = "archive"
include = ["*NerdFontMono-*.ttf"]
checksum.sha256 = "0c50b1ec676232a0c357419c5ba55bf1bba886da66de77b4d028794f0922cd44"
urls = [
  "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/AdwaitaMono.tar.xz",
  "https://sourceforge.net/projects/nerd-fonts.mirror/files/v3.5.0/AdwaitaMono.tar.xz"
]

["UbuntuMono"]
targetPath = "{{ $fontsPath }}"
type = "archive"
include = ["*NerdFontMono-*.ttf"]
checksum.sha256 = "e90f9a753ed4ba6266dbb59c2383885b568985514060917029f90e48606bbd2c"
urls = [
  "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/UbuntuMono.tar.xz",
