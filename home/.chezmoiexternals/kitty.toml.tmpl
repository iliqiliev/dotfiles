{{ if or (ne .os "linux") (not .manageGui) -}}
{{   abortEmpty -}}
{{ end -}}

{{ $arch := "" -}}
{{ if eq .chezmoi.arch "amd64" -}}
{{   $arch = "x86_64" -}}
{{ else if eq .chezmoi.arch "arm64" -}}
{{   $arch = "arm64" -}}
{{ else -}}
{{   abortEmpty -}}
{{ end -}}

[".local/kitty.app"]
type = "archive"
{{ $asset := print "kitty-*.*.*-" $arch ".txz" -}}
url = "{{ gitHubLatestReleaseAssetURL "kovidgoyal/kitty" $asset }}"
refreshPeriod = "672h"
