{{ if ne .os "linux" -}}
{{   abortEmpty -}}
{{ end -}}

{{ $fish := "/usr/bin/fish" -}}
{{ $VersionCheckCmd := "test (echo $FISH_VERSION | awk -F '.' '{print $1}') -ge 4" -}}
{{ if and (lookPath $fish) (exec $fish "-c" $VersionCheckCmd) -}}
{{   abortEmpty -}}
{{ end -}}

[".local/bin/fish"]
type = "archive-file"
path = "fish"
executable = true
{{ $arch := includeTemplate "archRust" . -}}
{{ $asset := print "fish-*-" .os "-" $arch ".tar.xz" -}}
url = "{{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" $asset }}"
refreshPeriod = "672h"
