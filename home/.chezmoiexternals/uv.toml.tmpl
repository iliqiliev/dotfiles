{{ $components := 1 -}}
{{ $libc := "musl" -}}
{{ $ext := "tar.gz" -}}

{{ if eq .os "windows" -}}
{{   $components = 0 -}}
{{   $libc = "msvc" -}}
{{   $ext = "zip" -}}
{{ end -}}

{{ if glob ".local/bin/uv*" -}}
{{/* If `uv` is already installed, let it manage itself. */ -}}
{{   abortEmpty -}}
{{ end -}}

{{ if and (eq .distro "android") (not (lookPath "python")) -}}
{{/* `uv` cannot install Python on Android, so we do it here. */ -}}
{{ $_ := exec "pkg" "install" "--yes" "python" -}}
{{ end -}}

["uv"]
targetPath = ".local/bin"
type = "archive"
stripComponents = {{ $components }}
executable = true
{{ $arch := includeTemplate "archRust" . -}}
{{ $asset := print "uv-" $arch "-*-" .os "-" $libc "." $ext -}}
url = "{{ gitHubLatestReleaseAssetURL "astral-sh/uv" $asset }}"
