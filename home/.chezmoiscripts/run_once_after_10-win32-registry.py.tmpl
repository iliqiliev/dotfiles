"""Set Windows registry settings."""

from os import environ as env
from pathlib import Path
from shutil import which
from typing import cast
from unittest.mock import patch
from winreg import (
    HKEY_CURRENT_USER,
    REG_DWORD,
    REG_EXPAND_SZ,
    REG_SZ,
    CreateKey,
    ExpandEnvironmentStrings,
    QueryValueEx,
    SetValueEx,
)

from dotenv import load_dotenv

from helpers import CHEZMOI_DATA, fmt, restart_explorer

AUTORUN = r"Software\Microsoft\Windows\CurrentVersion\Run"
"""AutoRun registry settings."""
EXPLORER = r"Software\Microsoft\Windows\CurrentVersion\Explorer"
"""Settings related to `Windows Explorer`."""
SEARCH = r"Software\Microsoft\Windows\CurrentVersion\Search"
"""Settings related to `Windows Search`."""

XDG_CACHE_HOME = r"%USERPROFILE%\.cache"
XDG_CONFIG_HOME = r"%USERPROFILE%\.config"
XDG_DATA_HOME = r"%USERPROFILE%\.local\share"
XDG_STATE_HOME = r"%USERPROFILE%\.local\state"

HOME = Path.home()


def main() -> None:
    fmt("[info]Setting registry settings ...")

    # Add directories to `%PATH%`.
    registry_path_prepend(rf"{env['USERPROFILE']}\scoop\shims")
    registry_path_prepend(r"%USERPROFILE%\.local\bin")
    registry_path_prepend(r"%USERPROFILE%\.local\share\mise\shims")

    # Set keyboard layouts.
    registry_set_many_data(
        r"Keyboard Layout\Preload",
        ("1", "00000409"),  # English (US)
        ("2", "00040402"),  # Bulgarian (Phonetic Traditional)
        personal=True,
    )

    # Disable mouse acceleration.
    registry_set(r"Control Panel\Mouse", "MouseSpeed", "0")
    registry_set(r"Control Panel\Mouse", "MouseThreshold1", "0")
    registry_set(r"Control Panel\Mouse", "MouseThreshold2", "0")

    # Set environment variables.
    registry_set_many_data(r"Environment", *parse_environment_d())

    # Restore the classic context menu in Windows 11.
    registry_set(
        r"Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32",
        name=None,
        data="",
    )

    # Free Super+V shortcut for external clipboard manager.
    registry_set(rf"{EXPLORER}\Advanced", "DisabledHotkeys", "V")
    # Show hidden files and folders in explorer.
    registry_set(rf"{EXPLORER}\Advanced", "Hidden", 1)
    # Show file extensions in explorer.
    registry_set(rf"{EXPLORER}\Advanced", "HideFileExt", 0)
    # Align taskbar to the left.
    registry_set(rf"{EXPLORER}\Advanced", "TaskbarAl", 0)
    # Hide widgets from the taskbar.
    registry_set(rf"{EXPLORER}\Advanced", "TaskbarDa", 0)
    # Add 'End task' button when right-clicking a program.
    registry_set(rf"{EXPLORER}\Advanced\TaskbarDeveloperSettings", "TaskbarEndTask", 1)
    # Change the app opened by the `CALC` key.
    registry_set(rf"{EXPLORER}\AppKey\18", "ShellExecute", "qalculate-gtk")
    # Hide 'Learn about this picture' icon.
    icon = "{2cc5ca98-6485-489a-920e-b3e88a6ccce3}"
    registry_set(rf"{EXPLORER}\HideDesktopIcons\NewStartPanel", icon, 1)

    # Autostart `AltSnap`. Written like this to be adopted by AltSnap's GUI.
    registry_set(AUTORUN, "AltSnap", rf'"{which("AltSnap.exe")}"')
    # Autostart `Ditto`.
    registry_set(AUTORUN, "Ditto", which("Ditto") or "Ditto")

    # Disable Bing in Start search.
    registry_set(SEARCH, "BingSearchEnabled", 0)
    # Hide the taskbar search box.
    registry_set(SEARCH, "SearchboxTaskbarMode", 0)

    fmt("[good]Registry settings imported successfully.")

    restart_explorer()


def registry_set(
    path: str,
    name: str | None,
    data: str | int,
    reg_type: int | None = None,
    personal: bool = False,
) -> None:
    """Set a `HKEY_CURRENT_USER` registry value."""
    if personal and CHEZMOI_DATA["isPersonal"] is not True:
        return

    if reg_type is None:
        if isinstance(data, str):
            if ExpandEnvironmentStrings(data) == data:
                reg_type = REG_SZ
            else:
                reg_type = REG_EXPAND_SZ
        else:
            reg_type = REG_DWORD

    try:
        with CreateKey(HKEY_CURRENT_USER, path) as key:
            SetValueEx(key, name, 0, reg_type, data)
    except PermissionError:
        fmt(rf"[fail]Failed to set [i]{name}[/] in [i]HKCU\{path}[/].")
        fmt("[warn]Key may be protected by the [i]UCPD[/] driver.")


def registry_set_many_data(
    path: str,
    *kvp: tuple[str, str | int],
    personal: bool = False,
) -> None:
    """Set multiple `HKEY_CURRENT_USER` registry values at once."""
    if personal and CHEZMOI_DATA["isPersonal"] is not True:
        return

    for name, data in kvp:
        registry_set(path, name, data)


def registry_path_prepend(new_path: str) -> None:
    """Add `new_path` to `%PATH%` if not already present."""
    with CreateKey(HKEY_CURRENT_USER, "Environment") as key:
        old_path, path_type = cast("tuple[str, int]", QueryValueEx(key, "Path"))

        if path_type != REG_EXPAND_SZ:
            raise TypeError("'PATH' type is not 'REG_EXPAND_SZ'.")

        for part in old_path.split(";"):
            if ExpandEnvironmentStrings(new_path) == ExpandEnvironmentStrings(part):
                return

        new_path = f"{new_path};{old_path}".rstrip(";")

        SetValueEx(key, "Path", 0, REG_EXPAND_SZ, new_path)


@patch.dict(env, clear=True, HOME=str(HOME))
def parse_environment_d() -> list[tuple[str, str]]:
    ENVIRONMENT_D = HOME / ".config/environment.d"

    for file in sorted(ENVIRONMENT_D.glob("*.conf")):
        load_dotenv(file, override=True)

    env.pop("HOME")

    return [(key, value.replace("/", "\\")) for key, value in env.items()]


if __name__ == "__main__":
    main()
