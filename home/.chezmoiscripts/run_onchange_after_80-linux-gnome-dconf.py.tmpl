"""Configure Dconf settings."""

from helpers import fmt, run


def main() -> None:
    fmt("[info]Loading Dconf settings ...", end=" ")
    run("dconf load /", input=DCONF_INI)
    fmt("[good]OK")


DCONF_INI: str = r"""
# {{ template `dconf.ini` . }}
"""

if __name__ == "__main__":
    main()
