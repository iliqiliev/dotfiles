"""Configure Dconf settings."""

from helpers import PIPE, fmt, run

cmd = "chezmoi execute-template '{{ template `dconf.ini` . }}'"
dconf_ini = run(cmd, out=PIPE).stdout

fmt("[info]Loading Dconf settings ...", end=" ")
run("dconf load /", input=dconf_ini)
fmt("[good]OK")
