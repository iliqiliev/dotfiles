"""Install packages using `scoop`."""

from ctypes import WinDLL
from pathlib import Path
from typing import TYPE_CHECKING

from requests import get as requests_get

from helpers import CHEZMOI_PACKAGES, SUDO, fmt, run

if TYPE_CHECKING:
    from collections.abc import Iterable


def check_installed(packages: Iterable[str]) -> None:
    """Check if the `packages` are installed."""
    missing = {name for name in packages if not (SCOOP_APPS / name).is_dir()}

    if not missing:
        return

    fmt(f"[fail]The following are missing: {' '.join(sorted(missing))}")
    raise SystemExit(1)


def is_admin() -> bool:
    """Check if the current process is running with admin privileges."""
    return WinDLL("shell32").IsUserAnAdmin() == 1


def install_scoop() -> None:
    """Install `Scoop` using the official installer script."""
    scoop_script = HOME / ".cache/scoop-installer.ps1"
    scoop_response = requests_get("https://get.scoop.sh", timeout=10)
    scoop_script.write_bytes(scoop_response.content)

    run_as_admin = "-RunAsAdmin" if is_admin() else None
    run("powershell -NoProfile -File", scoop_script, run_as_admin)


HOME = Path.home()
SCOOP = HOME / "scoop/shims/scoop.cmd"
SCOOP_APPS = HOME / "scoop/apps"
SCOOP_BUCKETS = HOME / "scoop/buckets"

GSUDO = SCOOP_APPS / "gsudo/current/gsudo.exe"
NEED_SUDO_PACKAGES = ("vcredist-aio", "virtio-guest-tools")
BUCKETS = (
    ("extras", None),
    ("sysinternals", None),
    ("versions", None),
    ("iliya", "https://github.com/iliqiliev/iliya-bucket"),
)


if SCOOP.exists():
    fmt("[info]Updating 'scoop' buckets ...")
    run(SCOOP, "update")
    fmt("[info]'scoop' buckets updated successfully.")
else:
    fmt("[info]Scoop not found. Installing it ...")
    install_scoop()

if not (HOME / "scoop/apps/git/current/cmd/git.exe").exists():
    fmt("[info]Git not found. Installing it ...")
    run(SCOOP, "install --no-update-scoop git")
    fmt("[good]Git installed successfully.")

for bucket_url in BUCKETS:
    bucket, url = bucket_url

    if (SCOOP_BUCKETS / bucket).is_dir():
        continue

    run(SCOOP, "bucket add", bucket, url)


available_packages = CHEZMOI_PACKAGES.intersection(
    package.stem for package in SCOOP_BUCKETS.glob("*/bucket/*.json")
)

user_packages = sorted(available_packages.difference(NEED_SUDO_PACKAGES))
sudo_packages = sorted(available_packages.intersection(NEED_SUDO_PACKAGES))

if user_packages:
    fmt("[info]Installing 'scoop' packages ...")
    run(SCOOP, "install --no-update-scoop", *user_packages)

    check_installed(user_packages)
    fmt("[good]Packages installed successfully.")

if SUDO != "false" and sudo_packages:
    fmt("[info]Installing packages that require admin privileges ...")
    run(GSUDO, SCOOP, "install --no-update-scoop", *sudo_packages)

    check_installed(sudo_packages)
    fmt("[good]Admin packages installed successfully. ")
