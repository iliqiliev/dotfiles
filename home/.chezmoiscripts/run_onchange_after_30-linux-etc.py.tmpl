# chezmoi:template:left-delimiter="# {{"
# {{ if or (ne .os "linux") (eq .sudo "false") (.isWork) -}}
# {{   abortEmpty -}}
# {{ end -}}
# Trigger this script if any file inside `root` changes:
# # {{ template "hashDirectory" (joinPath .chezmoi.workingTree "root") }}

"""Setup `/etc` directory."""

import json
from contextlib import suppress
from hashlib import sha256
from os import environ as env
from pathlib import Path

from helpers import PIPE, SUDO, fmt, run, sudo_cache

CACHE = Path(env["CHEZMOI_CACHE_DIR"]) / "etc-script-cache.json"
CHEZMOI_ROOT = Path(env["CHEZMOI_WORKING_TREE"]) / "root"
ROOT = Path(env.get("PREFIX", "/"))  # $PREFIX is "root" in Termux.

EXCLUSIONS: tuple[Path, ...] = (
    CHEZMOI_ROOT / "home/$USER",  # Managed by the `termux` script.
    CHEZMOI_ROOT / "README.md",  # README file, should not be placed in `/`.
)

if not CACHE.is_file():
    CACHE.write_text("{}")

cache: dict[str, str] = json.loads(CACHE.read_text())
"""Store a mapping of already-written `root_file` paths to their hashes.
Used to avoid requiring sudo access after the first time
that a non-readable file has been written to.
"""

root_files: dict[Path, str] = {}
"""Map each `root_file` that needs to be written to its new contents."""

for chezmoi_file in CHEZMOI_ROOT.rglob("*"):
    if any(chezmoi_file.is_relative_to(exclusion) for exclusion in EXCLUSIONS):
        continue

    if not chezmoi_file.is_file():
        continue

    relative_path = chezmoi_file.relative_to(CHEZMOI_ROOT)
    contents = chezmoi_file.read_text()

    if chezmoi_file.suffix == ".tmpl":
        # Remove the `.tmpl` suffix.
        relative_path = relative_path.with_suffix("")
        # Render the template.
        contents = run("chezmoi execute-template", input=contents, out=PIPE).stdout

        # Skip templates that render empty, e.g. using `abortEmpty`.
        if not contents:
            continue

    root_file = ROOT / relative_path

    cached_hash = cache.get(str(root_file))
    calculated_hash = sha256(contents.encode()).hexdigest()

    if cached_hash == calculated_hash:
        continue

    # Reading raises `PermissionError` if `root_file` is not readable.
    with suppress(FileNotFoundError, PermissionError):
        if root_file.read_text() == contents:
            continue

    root_files[root_file] = contents

if root_files:
    sudo_cache()

for root_file, contents in root_files.items():
    root_file_link = f"[link={root_file.as_uri()}]{root_file}"
    fmt(f"[info]Writing to '{root_file_link}' ...", end=" ")

    # `install` reads the new contents from stdin.
    run(SUDO, "install -D -m 644 /dev/stdin", root_file, input=contents)
    fmt("[good]OK")

    cache[str(root_file)] = sha256(contents.encode()).hexdigest()

CACHE.write_text(json.dumps(cache, indent=2))
