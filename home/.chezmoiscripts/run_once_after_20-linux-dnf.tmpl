#!/usr/bin/env -S uv run -qsw rich
# vim: filetype=py

# chezmoi:template:left-delimiter="# {{"
# {{ if or (not (lookPath "dnf")) (eq .sudo "false") -}}
# {{   abortEmpty -}}
# {{ end -}}

from subprocess import run
from typing import Literal

from rich import print as rich_print

SUDO: Literal["", "sudo"] = "# {{ .sudo }}"  # ty: ignore[invalid-assignment]


available_packages = '# {{ template "packages" . }}'.split()  # noqa: SIM905

rich_print("[bright_blue]Installing dnf packages ...[/]")
cmd = (SUDO, "dnf", "install", "--assumeyes", "--skip-unavailable", *available_packages)
run(tuple(filter(None, cmd)), check=True)
rich_print("[bright_green]Packages installed successfully.[/]")
