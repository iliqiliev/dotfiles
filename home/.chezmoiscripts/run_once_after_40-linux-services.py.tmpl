from getpass import getuser
from grp import getgrnam
from os import environ as env
from pathlib import Path
from shutil import which
from subprocess import CalledProcessError

from helpers import CHEZMOI_DATA, DEVNULL, SUDO, fmt, run, sudo_cache


def main() -> None:
    __systemd_service__("Sched_ext", "scx_loader.service")
    service_kmscon()
    service_virtualbox()


def __systemd_service__(
    pretty_name: str,
    service_name: str,
    now: bool = True,
) -> bool:
    if not Path(f"/usr/lib/systemd/system/{service_name}").is_file():
        return False

    now_arg = "--now" if now else None

    sudo_cache()

    fmt(f"[info]Setting up [i]{pretty_name}[/] service ...", end=" ")
    run(SUDO, "systemctl enable", now_arg, service_name, err=DEVNULL)
    fmt("[good]OK")
    return True


def __openrc_service__(
    pretty_name: str,
    service_name: str,
    runlevel: str | None = None,
) -> bool:
    if not Path(f"/etc/init.d/{service_name}").is_file():
        return False

    sudo_cache()

    fmt(f"[info]Setting up [i]{pretty_name}[/] service ...", end=" ")
    run(SUDO, "rc-service", service_name, "start")
    run(SUDO, "rc-update add", service_name, runlevel)
    fmt("[good]OK")
    return True


def service_kmscon() -> bool:
    if which(Path("/usr/bin/kmscon")) is None:
        return False

    service_name = "kmsconvt@.service"

    if not Path(f"/usr/lib/systemd/system/{service_name}").is_file():
        return False

    fmt("[info]Setting up [i]KMSCON[/] service ...", end=" ")

    try:
        run(SUDO, "systemctl disable getty@.service", err=DEVNULL)
        run(SUDO, f"systemctl enable {service_name}", err=DEVNULL)

    except CalledProcessError:
        run(SUDO, f"systemctl disable {service_name}", check=False)
        run(SUDO, "systemctl enable getty@service", check=False)
        return False

    fmt("[good]OK")
    return True


def service_virtualbox() -> bool:
    if CHEZMOI_DATA["productName"] != "VirtualBox" or env.get("container"):
        return False

    __systemd_service__("VirtualBox", "vboxservice.service")
    __openrc_service__("VirtualBox", "virtualbox-guest-additions", "boot")
    __openrc_service__("VirtualBox DRM", "virtualbox-drm-client", "default")

    if (user := getuser()) not in getgrnam("vboxsf").gr_mem:
        fmt("[info]Adding user to [i]vboxsf[/] group ...", end=" ")
        run(SUDO, "usermod -aG vboxsf", user)
        fmt("[good]OK")

    if which("VBoxClient-all") is None:
        return True

    fmt("[info]Setting up [i]VirtualBox[/] user services ...", end=" ")
    try:
        run("VBoxClient-all", out=DEVNULL)
    except CalledProcessError:
        fmt("[fail]FAILED")
        return False

    fmt("[good]OK")
    return True


if __name__ == "__main__":
    main()
