from helpers import SUDO, fmt, run


def main() -> None:
    fmt("[info]Installing dnf packages ...")
    run(SUDO, "dnf install --assumeyes --skip-unavailable", *PACKAGES)
    fmt("[good]Packages installed successfully.")


PACKAGES: set[str] = set(
    """
    # {{ template `packages` . }}
    """.split(),  # ruff: ignore[SIM905]
)

if __name__ == "__main__":
    main()
