"""Find and update `Steam` config files."""

from pathlib import Path

from vdf import dumps, loads

from helpers import fmt

HOME = Path.home()
STEAM_LIBRARY = HOME / "Games/Steam"
STEAM_ROOTS = (
    HOME / ".local/share/Steam",
    HOME / ".var/app/com.valvesoftware.Steam/data/Steam",
)


def main() -> None:
    try:
        if (STEAM_ROOT := steam_get_root()) is None:
            return
    except FileExistsError as e:
        fmt(f"[fail]{e}")
        raise SystemExit(1)

    library_id = steam_update_library(STEAM_ROOT)

    steam_update_config(STEAM_ROOT, library_id)


def steam_update_config(root: Path, library_id: str) -> None:
    localconfigs = set(root.glob("userdata/*/config/localconfig.vdf"))

    for path in localconfigs:
        account_id32 = int(path.parent.parent.name)
        username = steam_get_username(root, account_id32)

        fmt(f"[info]Updating [i]Steam[/] config for [i]{username}[/] ...", end=" ")

        parsed_vdf = loads(path.read_text(), mapper=DefaultDict)

        config = parsed_vdf["UserLocalConfigStore"]

        # This sets the default game library.
        config["LastInstallFolderIndex"] = library_id

        config["system"]["InGameOverlayScreenshotHotKey"] = "KEY_NONE"
        config["system"]["InGameOverlayShortcutKey"] = "Ctrl\tShift\tKEY_TAB"

        apps = config["Software"]["Valve"]["Steam"]["apps"]
        CS2 = "730"

        apps[CS2]["LaunchOptions"] = "%command% +exec user.cfg"

        path.write_text(dumps(parsed_vdf, pretty=True))

        fmt("[good]OK")


def steam_update_library(root: Path) -> str:
    libraryfolders = root / "steamapps/libraryfolders.vdf"

    parsed_vdf = loads(libraryfolders.read_text())

    largest_key = 0
    """Steam stores each library ID as an integer, starting from 0."""

    folders = parsed_vdf["libraryfolders"]

    for folder_id, folder_info in folders.items():
        largest_key = max(largest_key, int(folder_id))

        if Path(folder_info["path"]) == STEAM_LIBRARY:
            return folder_id

    fmt("[info]Adding [i]Steam[/] library ...", end=" ")

    library_id = str(largest_key + 1)

    folders[library_id] = {
        "path": STEAM_LIBRARY,
        "label": "Games",
    }

    libraryfolders.write_text(dumps(parsed_vdf, pretty=True))

    fmt("[good]OK")

    return library_id


def steam_get_root() -> Path | None:
    existing_roots = tuple(root for root in STEAM_ROOTS if root.is_dir())

    if len(existing_roots) == 1:
        return existing_roots[0]

    if len(existing_roots) > 1:
        raise FileExistsError("Multiple Steam installations found.")


def steam_get_username(root: Path, account_id32: int) -> str:
    ACCOUNT_ID_MASK = 0xFFFFFFFF
    """Bitmask that selects the low 32 bits of an integer."""

    loginusers = root / "config/loginusers.vdf"

    parsed_vdf = loads(loginusers.read_text())

    for account_id64, account_data in parsed_vdf["users"].items():
        if int(account_id64) & ACCOUNT_ID_MASK == account_id32:
            return account_data["PersonaName"]

    return str(account_id32)


class DefaultDict(dict[str, "str | DefaultDict"]):
    """A nested default dictionary."""

    def __missing__(self, key: str) -> DefaultDict:
        """Return a new empty DefaultDict when a key is missing."""
        empty_dict = DefaultDict()
        self[key] = empty_dict
        return empty_dict


if __name__ == "__main__":
    main()
