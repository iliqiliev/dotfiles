#!/usr/bin/env ash
# vim: filetype=sh
# chezmoi:template:left-delimiter="# {{"
# {{- if ne .distro "alpine" }}
# {{-   abortEmpty }}
# {{- end }}

set -eu

# shellcheck source=helpers/env.sh
source ~/.local/share/chezmoi/helpers/env.sh

if test "$CHEZ_SUDO" = "false"; then
    exit 0
fi

# Not available in containers.
if command -v setup-apkrepos >/dev/null; then
    print_blue "Adding community repository ..."
    $CHEZ_SUDO setup-apkrepos -c -1
    print_green "Community repository added successfully."
fi

print_blue "Syncing apk database ..."
$CHEZ_SUDO apk update
print_green "Apk database synced successfully."

AVAILABLE_PACKAGES=$(
    comm -12 \
        <(apk search --quiet | sort) \
        <(echo '# {{ template "packages" . }}' | tr " " "\n")
)

print_blue "Installing apk packages ..."
# shellcheck disable=2086
$CHEZ_SUDO apk add $AVAILABLE_PACKAGES
print_green "Packages installed successfully."
