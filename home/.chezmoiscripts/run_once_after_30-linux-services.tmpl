# chezmoi:template:left-delimiter="# {{"
# {{ if or (.os | ne "linux") (not .canSudo) -}}
# {{   abortEmpty -}}
# {{ end -}}

set -eu

# shellcheck source=helpers/helpers.sh
source "$CHEZMOI_WORKING_TREE"/helpers/helpers.sh

function main() {
    print_blue "Setting up system services ..."
    service_kmsconvt
    service_scx_loader
    service_virtualbox
    print_green "System services set up successfully."
}

function service_kmsconvt() {
    test -f "/usr/lib/systemd/system/kmsconvt@.service" || return

    print_blue "Setting up KMSCON service ..."

    $CHEZ_SUDO systemctl disable getty@.service
    $CHEZ_SUDO systemctl enable kmsconvt@.service

    $CHEZ_SUDO systemctl disable kmsconvt@tt1.service
    $CHEZ_SUDO systemctl enable getty@tty1.service

    print_green "KMSCON service set up successfully."
}

function service_scx_loader() {
    test -f "/usr/lib/systemd/system/scx_loader.service" || return

    $CHEZ_SUDO tee /etc/scx_loader.toml <<EOF >/dev/null
default_sched = "scx_lavd"
default_mode = "Gaming"

[scheds.scx_lavd]
auto_mode = []
gaming_mode = ["--performance"]
lowlatency_mode = ["--performance"]
powersave_mode = ["--powersave"]
server_mode = []
EOF

    print_blue "Setting up Sched_ext service ..."
    $CHEZ_SUDO systemctl enable --now scx_loader
    print_green "Sched_ext service set up successfully."
}

function service_virtualbox() {
    print_blue "Setting up VirtualBox service ..."
    service_virtualbox_systemd
    service_virtualbox_openrc
    print_green "VirtualBox service set up successfully."

    print_blue "Ensuring VirtualBox user session services are started ..."
    if ! VBoxClient-all >/dev/null; then
        print_yellow "Failed to start VirtualBox user session services."
        print_yellow "Continuing anyway as it is not critical."
        return
    fi
    print_green "VirtualBox user session services started successfully."

}

function service_virtualbox_systemd() {
    test -f /usr/lib/systemd/system/vboxservice.service || return
    $CHEZ_SUDO systemctl enable --now "vboxservice.service"
}

function service_virtualbox_openrc() {
    test -f /etc/init.d/virtualbox-guest-additions || return
    $CHEZ_SUDO rc-service virtualbox-guest-additions start
    $CHEZ_SUDO rc-update add virtualbox-guest-additions boot

    test -f /etc/init.d/virtualbox-drm-client || return
    $CHEZ_SUDO rc-service virtualbox-drm-client start
    $CHEZ_SUDO rc-update add virtualbox-drm-client default
}
