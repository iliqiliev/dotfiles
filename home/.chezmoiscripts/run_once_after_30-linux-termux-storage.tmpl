#!/usr/bin/env -S uv run -qsw rich
# vim: filetype=python

# chezmoi:template:left-delimiter="# {{"
# {{ if ne .distro "android" -}}
# {{   abortEmpty -}}
# {{ end -}}
# Trigger this script if any file inside `root/home/$USER` changes:
# # {{ template "hashDirectory" (joinPath .chezmoi.workingTree "root/home/$USER") }}

from contextlib import suppress
from filecmp import cmp
from os import environ as env
from pathlib import Path
from time import monotonic, sleep

from helpers import fmt, run

HOME = Path.home()
CHEZMOI_HOME = Path(env["CHEZMOI_WORKING_TREE"]) / "root/home/$USER"
TERMUX_STORAGE = HOME / "storage/shared"
TIMEOUT = 15


if not TERMUX_STORAGE.is_symlink():
    fmt("[info]Setting up Termux storage ...")

    run("termux-setup-storage")

    deadline = monotonic() + TIMEOUT
    fmt("[info]Waiting for permission pop-up to be accepted ...")

    while not TERMUX_STORAGE.is_symlink():
        if monotonic() > deadline:
            fmt(f"[fail]Timed out after {TIMEOUT} seconds.")
            raise SystemExit(1)
        sleep(500e-3)

    fmt("[good]Termux storage setup successfully.")

for source_file in CHEZMOI_HOME.rglob("*"):
    if not source_file.is_file():
        continue

    destination_file = HOME / source_file.relative_to(CHEZMOI_HOME)

    with suppress(FileNotFoundError):
        if cmp(source_file, destination_file, shallow=False):
            continue

    destination_file_link = f"[link={destination_file.as_uri()}]{destination_file}"
    fmt(f"[info]Writing to '{destination_file_link}' ...", end=" ")

    source_file.copy(destination_file)
    fmt("[good]OK")
