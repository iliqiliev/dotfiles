"""Set Windows registry settings."""

from os import environ as env
from pathlib import Path
from tempfile import NamedTemporaryFile
from unittest.mock import patch
from winreg import (
    HKEY_CURRENT_USER,
    REG_EXPAND_SZ,
    REG_SZ,
    CreateKey,
    ExpandEnvironmentStrings,
    QueryValueEx,
    SetValueEx,
)

from dotenv import load_dotenv

from helpers import DEVNULL, fmt, restart_explorer, run

HOME = Path.home()

ENVIRONMENT = CreateKey(HKEY_CURRENT_USER, "Environment")
"""The user's environment variables."""


def main() -> None:
    fmt("[info]Setting registry settings ...", end=" ")

    # Add directories to `%PATH%`.
    path_prepend(rf"{env['USERPROFILE']}\scoop\shims")
    path_prepend(r"%USERPROFILE%\.local\bin")
    path_prepend(r"%USERPROFILE%\.local\share\mise\shims")

    # Set environment variables.
    for name, value in parse_environment_d():
        if ExpandEnvironmentStrings(value) == value:
            value_type = REG_SZ
        else:
            value_type = REG_EXPAND_SZ

        SetValueEx(ENVIRONMENT, name, 0, value_type, value)

    with NamedTemporaryFile(
        "w",
        encoding="utf-16",
        suffix=".reg",
        delete_on_close=False,
    ) as file:
        file.write(REGISTRY_REG)
        # The file must be closed before `reg` uses it.
        file.close()
        run("reg import", Path(file.name), err=DEVNULL)

    fmt("[good]OK")

    restart_explorer()


def path_prepend(new_path: str) -> None:
    """Add `new_path` to `%PATH%` if not already present."""
    old_path: str
    old_path, path_type = QueryValueEx(ENVIRONMENT, "Path")

    if path_type != REG_EXPAND_SZ:
        raise TypeError("'PATH' type is not 'REG_EXPAND_SZ'.")

    for part in old_path.split(";"):
        if ExpandEnvironmentStrings(new_path) == ExpandEnvironmentStrings(part):
            return

    new_path = f"{new_path};{old_path}".rstrip(";")

    SetValueEx(ENVIRONMENT, "Path", 0, REG_EXPAND_SZ, new_path)


@patch.dict(env, clear=True, HOME=str(HOME))
def parse_environment_d() -> list[tuple[str, str]]:
    ENVIRONMENT_D = HOME / ".config/environment.d"

    for file in sorted(ENVIRONMENT_D.glob("*.conf")):
        load_dotenv(file, override=True)

    env.pop("HOME")

    return [(key, value.replace("/", "\\")) for key, value in env.items()]


REGISTRY_REG: str = """
# {{ template `registry.reg` . }}
"""

if __name__ == "__main__":
    main()
