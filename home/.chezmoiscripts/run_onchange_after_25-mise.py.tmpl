"""Set up a development environment using `mise`."""

import json

from helpers import CHEZMOI_DATA, DEVNULL, HOME, PIPE, fmt, path_add, run

MISE_LINK: str = "[i link=https://mise.jdx.dev/]mise[/]"


def main() -> None:
    path_add(HOME / ".local/bin")
    mise_self_update()
    mise_bootstrap()


def mise_self_update() -> None:
    output = run("mise version --json", out=PIPE).stdout
    version_info: dict[str, str] = json.loads(output)

    current = version_info["version"].split()[0]
    latest = version_info["latest"]

    if current == latest:
        return

    fmt(f"[info]Downloading {MISE_LINK} update ...")
    run("mise self-update --yes", out=DEVNULL)

    fmt(f"[good]{MISE_LINK} has been updated successfully:", end=" ")
    fmt(f"[warn][strike]{current}[/][/] -> [good]{latest}")


def mise_bootstrap() -> None:
    """Perform full bootstrap with `mise`."""
    if not run("mise bootstrap status --missing", check=False, out=DEVNULL).returncode:
        return

    skip = "--skip=user" if CHEZMOI_DATA["distro"] == "android" else None
    """Skip configuring the login shell on `Termux`.

    Termux sets the login shell with the `~/.termux/shell` symlink instead.
    """

    fmt(f"[info]Performing {MISE_LINK} bootstrap ...")
    run("mise bootstrap --yes", skip)
    fmt(f"[good]{MISE_LINK} bootstrap completed successfully.")


if __name__ == "__main__":
    main()
