{{/* `zdiff3` was added in git 2.35. */ -}}

{{ $style := "diff3" -}}

{{ if lookPath "git" -}}
{{   $version := output "git" "--version" | regexFind `[0-9]+\.[0-9]+\.[0-9]+` -}}
{{   if semverCompare ">=2.35" $version -}}
{{     $style = "zdiff3" -}}
{{   end -}}
{{ end -}}

[merge]
    conflictstyle = {{ $style }}
