# vim: filetype=gitconfig

[include]
    path = delta
    path = conflictstyle
    path = user

[core]
    autocrlf = false
    eol = lf

[pull]
    rebase = true

[url "https://github.com/"]
    insteadOf = "gh:"

[url "https://codeberg.org/"]
    insteadOf = "cb:"

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
