# vim: filetype=gitconfig

[include]
    path = conflictstyle
    path = user

[core]
    autocrlf = false
    eol = lf
    pager = delta

[delta]
    hyperlinks = true
    navigate = true
    tabs = 4

[interactive]
    diffFilter = delta --color-only

[pull]
    rebase = true

[rebase]
    autoStash = true

[url "https://github.com/"]
    insteadOf = "gh:"

[url "https://codeberg.org/"]
    insteadOf = "cb:"

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
