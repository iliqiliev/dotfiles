# vim: filetype=gitconfig

[include]
    path = delta
    path = user

[core]
    autocrlf = false
    eol = lf

[merge]
    conflictstyle = diff3

[url "https://github.com/"]
    insteadOf = "gh:"

[url "https://codeberg.org/"]
    insteadOf = "cb:"

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
