// vim: filetype=javascript

/* if .isPersonal -*/
// Do not show a warning if the built-in password manager is disabled.
user_pref("browser.preferences.config_warning.warningPasswordManager.dismissed", true);
// Never ask to translate Bulgarian websites.
user_pref("browser.translations.neverTranslateLanguages", "bg");
// Do not ask to save credit card details.
user_pref("extensions.formautofill.creditCards.enabled", false);
// Do not ask to save login details.
user_pref("signon.rememberSignons", false);
/*- end */

// Show a warning when opening about:config.
user_pref("browser.aboutConfig.showWarning", false);
// Allow selecting a different default search engine in private mode.
user_pref("browser.search.separatePrivateDefault.ui.enabled", true);
// Open previous windows and tabs on startup.
user_pref("browser.startup.page", 3);
// Enable auto-scrolling with middle mouse button.
user_pref("general.autoScroll", true);
// Change the device name used for Sync.
user_pref("identity.fxaccounts.account.device.name", "/* .chezmoi.hostname */");
// Block websites from requesting notifications.
user_pref("permissions.default.desktop-notification", 2);
// [Firefox] Use vertical tabs.
user_pref("sidebar.verticalTabs", true);
// [Firefox] Hide first-time vertical tabs helper.
user_pref("sidebar.verticalTabs.dragToPinPromo.dismissed", true);
// [Zen] Skip Zen's welcome screen.
user_pref("zen.welcome-screen.seen", true);
