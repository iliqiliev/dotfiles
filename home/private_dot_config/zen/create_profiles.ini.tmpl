; chezmoi:template:left-delimiter=";{{"
;{{- $profilePath := joinPath .chezmoi.homeDir ".config/zen/profile" -}}

[Profile0]
Name=;{{ .distro }}-;{{ .chezmoi.hostname }}
IsRelative=0
Path=;{{ $profilePath }}
Default=1

[General]
StartWithLastProfile=1
Version=2

[Install;{{ mozillaInstallHash (get . "mozillaPath" | default "/opt/zen-browser-bin") }}]
Default=;{{ $profilePath }}
Locked=1
