# vim: filetype=conf
# chezmoi:template:left-delimiter="# {{"

# XDG User Directories.
XDG_CACHE_HOME="${HOME}/.cache"
XDG_CONFIG_HOME="${HOME}/.config"
XDG_DATA_HOME="${HOME}/.local/share"
XDG_STATE_HOME="${HOME}/.local/state"
# {{ if ne .os "windows" -}}
XDG_DATA_DIRS="/usr/share:/usr/local/share:/var/lib/flatpak/exports/share:${XDG_DATA_HOME}/flatpak/exports/share"
XDG_CONFIG_DIRS="/etc/xdg"
# {{- end }}

# $XDG_CACHE_HOME
NUGET_PACKAGES="${XDG_CACHE_HOME}/NuGetPackages"
PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME}/python"
RUFF_CACHE_DIR="${XDG_CACHE_HOME}/ruff"

# $XDG_CONFIG_HOME
CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME}/claude"
COPILOT_HOME="${XDG_CONFIG_HOME}/copilot"
GEMINI_CLI_HOME="${XDG_CONFIG_HOME}/gemini"
NPM_CONFIG_USERCONFIG="${XDG_CONFIG_HOME}/npm/npmrc"

# $XDG_DATA_HOME
CARGO_HOME="${XDG_DATA_HOME}/cargo"
KODI_DATA="${XDG_DATA_HOME}/kodi"
RUSTUP_HOME="${XDG_DATA_HOME}/rustup"
WINEPREFIX="${XDG_DATA_HOME}/wine"

# $XDG_STATE_HOME
HISTFILE="${XDG_STATE_HOME}/bash/history"
PYTHON_HISTORY="${XDG_STATE_HOME}/python_history"
