# vim: filetype=toml
# chezmoi:template:left-delimiter="# {{"

[bootstrap.packages]
# Gcc.
"apk:build-base" = "latest"  # Just `gcc` is not enough.
"apt:clang" = { version = "latest", env = "android" }  # `gcc` is not available on Termux.
"apt:gcc" = { version = "latest", env = "!android" }  # But is available on Debian-based distros.
"dnf:gcc" = "latest"
"pacman:gcc" = "latest"

[bootstrap.user]
login_shell = "{{ xdg_data_home }}/mise/installs/fish/global/fish"

[env]
HOME = { default = "$USERPROFILE" }
# XDG User Directories:
XDG_CACHE_HOME = { default = "$HOME/.cache" }
XDG_CONFIG_HOME = { default = "$HOME/.config" }
XDG_DATA_HOME = { default = "$HOME/.local/share" }
XDG_STATE_HOME = { default = "$HOME/.local/state" }
# Needed on Windows.
BAT_CONFIG_DIR = "$XDG_CONFIG_HOME/bat"
TEALDEER_CONFIG_DIR = "$XDG_CONFIG_HOME/tealdeer"
YAZI_CONFIG_HOME = "$XDG_CONFIG_HOME/yazi"
YAZI_FILE_ONE = "{% if os() == 'windows' %}{{ vars.git_root }}/usr/bin/file{% else %}file{% endif %}"

[tool_alias]
bash-language-server = "npm:bash-language-server"
fish = "aqua:fish-shell/fish-shell"
fish-lsp = "npm:fish-lsp"
miss_hit = "pypi:miss_hit"
sqruff = "aqua:quarylabs/sqruff"
tclint = "pypi:tclint"
yaml-language-server = "npm:yaml-language-server"

[tools]
bash-language-server = "latest"  # Aliased.
bat = "latest"
chezmoi = "latest"
delta = "latest"
dua = "latest"
eza = "latest"
fastfetch = "latest"
fd = "latest"
fish = { version = "latest", os = "unix" }  # Aliased.
fish-lsp = { version = "latest", os = "unix" }  # Aliased.
fzf = "latest"
lazygit = "latest"
lua-language-server = "latest"
miss_hit = { version = "latest", expose = "miss_hit_core", uvx_args = "--quiet" }  # Aliased.
node = "latest"
pandoc = "latest"
ripgrep = "latest"
ripgrep-all = { version = "latest", os = "unix" }
ruff = "latest"
rumdl = "latest"
shellcheck = "latest"
shfmt = "latest"
sqruff = "latest"  # Aliased.
starship = "latest"
stylua = "latest"
tclint = { version = "latest", uvx_args = "--quiet" }  # Aliased.
tealdeer = "latest"
tombi = "latest"
topgrade = "latest"
tree-sitter = "latest"
ty = "latest"
usage = "latest"
uv = { path = "~/.local/bin" }
yaml-language-server = "latest"  # Aliased.
yazi = "latest"
zoxide = "latest"

[settings]
all_compile = false  # This will become the default in `v2027.8.0`.
disable_hints = [
  "auto_update",  # Hints about the ability to enable `mise` to self-update automatically.
  "system_packages_missing",  # Hints about missing bootstrap packages.
  "upgrade_auto_prune",  # Hints about the ability to disable auto-prunning.
]

[vars]
git_root = "${GIT_INSTALL_ROOT:-$HOME/scoop/apps/git/current}"
