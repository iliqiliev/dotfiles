# vim: filetype=toml
# chezmoi:template:left-delimiter="# {{"

[bootstrap.packages]
"apk:build-base" = "latest"  # Just `gcc` is not enough.
"apk:tree-sitter-cli" = "latest"  # mise's version cannot find `/lib64/ld-linux-x86-64.so.2`.
# {{ if eq .distro "android" -}}
"apt:clang" = "latest"  # `gcc` is not available on Termux.
"apt:nodejs" = "latest"  # mise's version cannot find `/lib/ld-musl-aarch64.so.1`.
"apt:tree-sitter" = "latest"  # mise's version cannot find `/lib/ld-musl-aarch64.so.1`.
# {{ else -}}
"apt:gcc" = "latest"
# {{ end -}}
"dnf:gcc" = "latest"
"pacman:gcc" = "latest"

[env]
HOME = { default = "$USERPROFILE" }
# XDG User Directories:
XDG_CACHE_HOME = "$HOME/.cache"
XDG_CONFIG_HOME = "$HOME/.config"
XDG_DATA_HOME = "$HOME/.local/share"
XDG_STATE_HOME = "$HOME/.local/state"

[tool_alias]
bashls = "npm:bash-language-server"
fish-lsp = "npm:fish-lsp"
miss_hit = "pypi:miss_hit"
sqruff = "aqua:quarylabs/sqruff"
tclint = "pypi:tclint"
yaml-language-server = "npm:yaml-language-server"

[tools.bashls]  # Aliased.
depends = "node"
version = "latest"

[tools.bat]
version = "latest"

[tools.chezmoi]
version = "latest"

[tools.delta]
version = "latest"

[tools.dua]
version = "latest"

[tools.eza]
version = "latest"

[tools.fastfetch]
version = "latest"

[tools.fd]
version = "latest"

[tools.fish-lsp]  # Aliased.
allow_low_downloads = true
depends = "node"
os = ["unix"]
version = "latest"

[tools.fzf]
version = "latest"

[tools.lazygit]
version = "latest"

[tools.lua-language-server]
version = "latest"

[tools.miss_hit]  # Aliased.
expose = ["miss_hit_core"]  # This exposes `mh_style` and `mh_metric`.
uvx_args = "--quiet"
version = "latest"

[tools.node]
version = "latest"

[tools.pandoc]
version = "latest"

[tools.ripgrep]
version = "latest"

[tools.ripgrep-all]
depends = ["pandoc"]
os = ["unix"]
version = "latest"

[tools.ruff]
version = "latest"

[tools.rumdl]
version = "latest"

[tools.shellcheck]
version = "latest"

[tools.shfmt]
version = "latest"

[tools.sqruff]  # Aliased.
version = "latest"

[tools.starship]
version = "latest"

[tools.stylua]
version = "latest"

[tools.tclint]  # Aliased.
depends = "uv"
uvx_args = "--quiet"
version = "latest"

[tools.tealdeer]
version = "latest"

[tools.tombi]
version = "latest"

[tools.topgrade]
version = "latest"

[tools.tree-sitter]
# Needs a C compiler.
version = "latest"

[tools.ty]
version = "latest"

[tools.usage]
version = "latest"

[tools.uv]
path = "~/.local/bin"

[tools.yaml-language-server]  # Aliased.
depends = ["node"]
version = "latest"

[tools.yazi]
version = "latest"

[tools.zoxide]
depends = ["fzf"]
version = "latest"

[settings]
disable_hints = ["auto_update", "upgrade_auto_prune"]
node.compile = false
disable_tools = [
  # {{ if list "alpine" "android" | has .distro -}}
  "tree-sitter",
  # {{ end -}}
  # {{ if list "android" | has .distro -}}
  "node",
  # {{ end -}}
]
