# Font family.
# It is automatically installed by `chezmoi`.
font_family AdwaitaMono Nerd Font Mono

# Font size in pts.
# Determined by: chezmoi execute-template {{ "'{{ sub .fonts.size 3 }}'" }}
font_size {{ sub .fonts.size 3 }}

# Show hyperlink target in a small box,
# sized to fit the URL, just below the mouse cursor.
hyperlink_target_position tooltip

# Save and restore the state of every kitty window on logout.
restore_session_after_logout yes

# Number of lines of history to keep in memory for scrolling back.
scrollback_lines 20000

# Change the default scrollbar display behavior to also show when hovered.
scrollbar scrolled-or-hovered

# Show hyperlink targets when `Ctrl` is pressed.
# Default is `never`.
show_hyperlink_targets ctrl

# Prevent low contrast between foreground and background colors.
# Possible values range from 0 to 21.
text_fg_override_threshold 4.5 ratio

# The window padding (in pts).
# Four values set top, right, bottom and left.
window_padding_width 5 5 5 5

# Keyboard binds.
map kitty_mod+l clear_terminal scrollback active

# Mouse binds.
mouse_map ctrl+wheel_up press ungrabbed,grabbed change_font_size all +2
mouse_map ctrl+wheel_down press ungrabbed,grabbed change_font_size all -2
mouse_map ctrl+wheel_left press ungrabbed,grabbed previous_tab
mouse_map ctrl+wheel_right press ungrabbed,grabbed next_tab
