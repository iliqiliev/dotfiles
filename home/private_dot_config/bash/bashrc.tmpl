#!/usr/bin/env bash
# vim: filetype=sh
# chezmoi:template:left-delimiter="# {{"
# chezmoi:template:line-endings=lf

# ignoredups, ignorespace, erasedups.
export HISTCONTROL=ignoreboth:erasedups

# Load `environment.d` if it was not.
if ! test -v ENVIRONMENT_D_SOURCED; then
    set -o allexport

    for file in ~/.config/environment.d/*.conf; do
        # shellcheck disable=SC1090
        source "$file"
    done

    set +o allexport
    unset file
fi

# Source `ble.sh`.
if test -r ~/.local/share/mise/installs/blesh/ble.sh; then
    # shellcheck source=/dev/null
    source -- ~/.local/share/mise/installs/blesh/ble.sh
fi

# Aliases:
# shellcheck source=home/private_dot_config/fish/conf.d/20_aliases.fish
source ~/.config/bash/aliases

# Abbreviations/Aliases:
# shellcheck source=home/private_dot_config/fish/conf.d/30_abbreviations.fish
source ~/.config/bash/abbreviations

# Initialize starship.rs.
eval -- "$(starship init bash --print-full-init 2>/dev/null || true)"

# Initialize zoxide.
eval -- "$(zoxide init bash || true)" 2>/dev/null
# {{ if eq .os "windows" -}}
# Fix zoxide using `cygpath` with `brush` shell.
function __zoxide_pwd() { \builtin pwd -L; }
# {{ end -}}

function yazi() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd-file.XXXXXX")"
    command yazi "$@" --cwd-file="$tmp"

    IFS= read -r -d '' cwd <"$tmp"
    test "$cwd" != "$PWD" &&
        builtin cd -- "$cwd" || true

    command rm -f -- "$tmp"
}
