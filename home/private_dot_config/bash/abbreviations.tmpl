function abbr() {
    # Mimic behaviour of `fish` so that existing abbreviations can be used.
    local KEY="$1"
    local VALUE="$2"

    # https://github.com/akinomyoga/ble.sh/wiki/Manual-%C2%A77-Completion#user-content-sec-sabbrev
    if declare -F ble-sabbrev >/dev/null; then
        ble-sabbrev "${KEY}"="${VALUE}"
    else
        # shellcheck disable=SC2139
        alias "${KEY}"="${VALUE}"
    fi
}

# These are the fish abbreviations.
{{ include "private_dot_config/fish/conf.d/30_abbreviations.fish" -}}

# These are fish built-ins so they are not listed in the fish abbreviations file.
abbr .. "cd .."
abbr ll "ls -l"
abbr la "ls -la"
