# name: Show usage hint for automatic suggestions
# type: boolean
autosuggest.hint = False

# name: Auto-update the Clink program files
# type: enum
# options: off,check,prompt,auto
clink.autoupdate = off

# name: Controls what startup logo to show
# type: enum
# options: none,full,short
clink.logo = none

# name: Auto-answer terminate prompt
# type: enum
# options: off,answer_yes,answer_no
cmd.auto_answer = answer_yes

# name: Argmatcher color
# type: color
color.argmatcher = sgr 1;38;5;40

# name: Shell command completions
# type: color
color.cmd = bold

# name: Color for < and > redirection symbols
# type: color
color.cmdredir = sgr 38;5;172

# name: Color for & and | command separators
# type: color
color.cmdsep = sgr 38;5;135

# name: Color for comment row
# type: color
color.comment_row = sgr 38;5;87;48;5;18

# name: Description completion color
# type: color
color.description = sgr 38;5;39

# name: Color for direnv banner messages
# type: color
color.direnv_banner = sgr 0;3;38;5;136

# name: Doskey completions
# type: color
color.doskey = sgr 1;38;5;75

# name: Color for executable command word
# type: color
color.executable = sgr 1;38;5;33

# name: Filtered completion color
# type: color
color.filtered = bold

# name: Flag color
# type: color
color.flag = sgr 38;5;117

# name: Hidden file completions
# type: color
color.hidden = sgr 38;5;160

# name: History expansion color
# type: color
color.histexpand = sgr 97;48;5;55

# name: Horizontal scroll marker color
# type: color
color.horizscroll = sgr 38;5;16;48;5;30

# name: Input text color
# type: color
color.input = sgr 38;5;214

# name: Readonly file completions
# type: color
color.readonly = sgr 38;5;28

# name: Selection color
# type: color
color.selection = sgr 38;5;16;48;5;179

# name: Color for dim text in the suggestion list header
# type: color
color.suggestionlist_dim = sgr 38;5;242

# name: Color for highlight in the suggestion list
# type: color
color.suggestionlist_highlight = sgr 38;5;87

# name: Color for markup in the suggestion list
# type: color
color.suggestionlist_markup = sgr 38;2;253;174;31

# name: Color for the current selected suggestion
# type: color
color.suggestionlist_selected = sgr 48;5;238

# name: Color for transient divider line
# type: color
color.transient_divider_line = sgr 38;5;240

# name: Color for duration text in transient line
# type: color
color.transient_divider_text = sgr 38;5;214

# name: Color for unrecognized command word
# type: color
color.unrecognized = sgr 38;5;203

# name: The number of history lines to save
# type: integer
history.max_lines = 0

# name: Automatically expand ~ to home directory
# type: boolean
tilde.autoexpand = True

# name: Show a tip when Clink starts
# type: boolean
tips.enable = False
