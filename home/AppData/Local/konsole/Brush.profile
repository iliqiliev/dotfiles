[Appearance]
ColorScheme=Adwaita Light
Font=AdwaitaMono Nerd Font Mono,12

[General]
Command=~/.local/bin/brush.exe --rcfile $USERPROFILE/.config/bash/bashrc
Directory=$USERPROFILE
Environment=TERM=xterm-256color,COLORTERM=truecolor,BAT_THEME=Monokai Extended Light
Name=Brush

[Scrolling]
HistoryMode=2
