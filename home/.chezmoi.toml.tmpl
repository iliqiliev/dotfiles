# Use 'chezmoi cat-config' to preview this file.

{{ $name := "Iliya Iliev" -}}
{{ $email := "iliq0000@proton.me" -}}
{{ $isPersonal := promptBoolOnce . "isPersonal" "Are you Iliya Iliev" false -}}
{{ $isWork := and ($isPersonal) (env "USERDNSDOMAIN" | eq "AD.BTK.BG") -}}
{{ if not $isPersonal -}}
{{   $email = promptStringOnce . "email" "Email (for git)" "" -}}
{{   $name = promptStringOnce . "name" "Name (for git)" ($email | splitList "@" | first) -}}
{{ end -}}

{{ $os := .chezmoi.os | lower -}}
{{ if eq $os "android" -}}
{{   $os = "linux" -}}
{{ end -}}

{{ $distro := coalesce (get .chezmoi.osRelease "idLike")
                       (get .chezmoi.osRelease "id")
                       (.chezmoi.os)
                       | splitList " " | last | lower -}}

{{ $manageGui := and (ne $distro "android")
                     (env "container" | eq "")
                     (promptBoolOnce . "manageGui" "Manage GUI applications" true) -}}

{{ $useSudo := false -}}{{/* useSudo is for caching the answer to promptBoolOnce */ -}}
{{ $sudo := "su root -c" -}}
{{ if or (eq .chezmoi.uid "0") (eq $distro "android") -}}
{{   $sudo = "" -}}
{{ else if promptBoolOnce . "useSudo" "Ask for admin/sudo privileges when needed" true -}}
{{   $useSudo = true -}}
{{   if lookPath "doas" -}}
{{     $sudo = "doas" -}}
{{   else if lookPath "gsudo" -}}
{{     $sudo = "gsudo" -}}
{{   else if lookPath "sudo" -}}
{{     $sudo = "sudo" -}}
{{   end -}}
{{ else -}}
{{   $sudo = "false" -}}
{{ end -}}

{{ $installGnome := false -}}
{{ $productName := "" -}}
{{ $verticalResolution := 0 -}}
{{ if eq $os "linux" -}}
{{   $gnomeInstalled := lookPath "gnome-shell" | ne "" -}}
{{   $installGnome = and $manageGui $useSudo (or ($gnomeInstalled) (promptBoolOnce . "installGnome" "Install Gnome desktop" false)) -}}
{{   $cmdArgs := list "-c" "grep -osm1 '[0-9]*$' /sys/class/graphics/*/virtual_size || true" -}}
{{   $verticalResolution = outputList "sh" $cmdArgs | trim | atoi -}}
{{   $productFile := "/sys/devices/virtual/dmi/id/product_name" -}}
{{   $productName = and (stat $productFile | default "") (include $productFile) | trim -}}
{{ else if eq $os "windows" -}}
{{   $cmdArgs := list "-nop" "-c" "gpv HKLM:/HARDWARE/DESCRIPTION/System/BIOS SystemProductName" -}}
{{   $productName = outputList "powershell" $cmdArgs | trim -}}
{{   $cmdArgs := list "-nop" "-c" "Add-Type -A System.Windows.Forms; [Windows.Forms.Screen]::PrimaryScreen.Bounds.Height" -}}
{{   $verticalResolution = outputList "powershell" $cmdArgs | trim | atoi -}}
{{ end -}}

[data]
isPersonal = {{ $isPersonal }}
isWork = {{ $isWork }}
name = {{ $name | quote }}
email = {{ $email | quote }}
os = {{ $os | quote }}
distro = {{ $distro | quote }}
manageGui = {{ $manageGui }}
useSudo = {{ $useSudo }}
installGnome = {{ $installGnome }} # Linux only
productName = {{ $productName | quote }}

[data.fonts]
{{ $size := 0 -}}
{{ if gt $verticalResolution 1080 -}}
{{ $size = 20 -}}
{{ else if or (gt $verticalResolution 800) (eq $verticalResolution 0) -}}
{{ $size = 16 -}}
{{ else -}}
{{ $size = 12 -}}
{{ end -}}
# Font size chosen from detected vertical resolution: {{ $verticalResolution }}px
size = {{ $size }}

[diff]
pager = {{ and (lookPath "delta") "delta" | quote }}

[env]
{{ $localBin := joinPath .chezmoi.homeDir ".local/bin" -}}
{{ $pathList := env "PATH" | splitList .chezmoi.pathListSeparator -}}
CHEZ_DISTRO = {{ $distro | quote }}
CHEZ_SUDO = {{ $sudo | quote }}
CHEZ_IS_PERSONAL = {{ $isPersonal | quote }}
PATH = '{{ prepend $pathList $localBin | uniq | join .chezmoi.pathListSeparator }}'
PSExecutionPolicyPreference = "Bypass"

{{ if eq $distro "android" -}}
[interpreters.""]
command = 'sh'
args = ['-c', 'termux-fix-shebang "$1" && exec "$1"', '--']

[interpreters.fish]
command = 'sh'
args = ['-c', 'termux-fix-shebang "$1" && exec "$1"', '--']

{{ end -}}

[interpreters.ps1]
command = "powershell"
args = ["-nol", "-nop", "-f", "{{ .chezmoi.workingTree }}/helpers/env.ps1"]

[interpreters.py]
# Unset Python interpeter.
