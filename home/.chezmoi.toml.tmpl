# Use 'chezmoi cat-config' to preview this file.

[data]
{{ $os := .chezmoi.os | lower | replace "android" "linux" -}}
{{ if not (list "linux" "windows" | has $os) -}}
{{   println "DOTFILES ERROR: unsupported OS:" $os | writeToStdout -}}
{{   exit 1 -}}
{{ else if not (list "amd64" "arm64" | has .chezmoi.arch) -}}
{{   println "DOTFILES ERROR: unsupported architecture:" .chezmoi.arch | writeToStdout -}}
{{   exit 1 -}}
{{ end -}}
os = "{{ $os }}"
{{ $distro := coalesce (index .chezmoi.osRelease "idLike")
                       (index .chezmoi.osRelease "id")
                       | default .chezmoi.os | splitList " " | last | lower -}}
{{ $supportedDistros := list "alpine" "android" "arch" "debian" "fedora" "ubuntu" "windows" -}}
{{ if not ($supportedDistros | has $distro) -}}
{{   println "DOTFILES WARNING: unsupported distribution:" $distro | writeToStdout -}}
{{ end -}}
distro = "{{ $distro }}"
{{ $isPersonal := false -}}
{{ if hasKey . "isPersonal" -}}
{{   $isPersonal = .isPersonal -}}
{{ else if (env "CHEZ_IS_PERSONAL") -}}
{{   $isPersonal = eq (env "CHEZ_IS_PERSONAL") ("1") -}}
{{ else -}}
{{   $isPersonal = promptBool "Are you Iliya Iliev" false -}}
{{ end -}}
isPersonal = {{ $isPersonal }}
isWork = {{ and ($isPersonal) (eq (env "USERDNSDOMAIN") ("AD.BTK.BG")) }}
{{ $email := "iliq0000@proton.me" -}}
{{ $name := "Iliya Iliev" -}}
{{ if not $isPersonal -}}
{{   $email = promptStringOnce . "email" "Email (for git)" "" -}}
{{   $emailBase := $email | splitList "@" | first -}}
{{   $nameGuess := regexReplaceAll "[^A-Za-z]+" $emailBase " " | trim | lower | title -}}
{{   $name = promptStringOnce . "name" "Name (for git)" $nameGuess -}}
{{ end -}}
email = "{{ $email }}"
name = "{{ $name }}"
{{ $sudo := "false" -}}
{{ if index . "sudo" -}}
{{   $sudo = .sudo -}}
{{ else if or (eq .chezmoi.uid "0")
              (eq $distro "android")
              (and (eq $os "windows") (exec "net" "session")) -}}
{{   $sudo = "" -}}
{{ else if and (or (lookPath "sudo") (eq $os "windows"))
               (promptBool "Use admin/sudo when needed" true) -}}
{{   $sudo = "sudo" -}}
{{ end -}}
sudo = "{{ $sudo }}"
{{ if eq $os "linux" -}}
{{   $productFile := "/sys/devices/virtual/dmi/id/product_name" -}}
productName = "{{ and (stat $productFile) (include $productFile | trim) -}}"
{{ else if eq $os "windows" -}}
{{   $productKey := "HKLM:/HARDWARE/DESCRIPTION/System/BIOS SystemProductName" -}}
productName = "{{ output "powershell" "-nop" "-c" "gpv" $productKey | trim -}}"
{{ end -}}
{{ $manageGui := and (ne $distro "android")
                     (not (env "container"))
                     (promptBoolOnce . "manageGui" "Manage GUI applications" true) -}}
manageGui = {{ $manageGui }}
manageGnome = {{ and (eq $os "linux")
                     ($manageGui)
                     (ne $sudo "false")
                     (or (ne (lookPath "gnome-shell") ("")) (promptBoolOnce . "manageGnome" "Manage Gnome" false)) }}

[diff]
exclude = ["scripts"]
pager = "delta"

[env]
{{ $pathList := env "PATH" | splitList .chezmoi.pathListSeparator -}}
{{ if eq $os "windows" -}}
{{   $pathList = joinPath .chezmoi.homeDir "scoop/shims" | prepend $pathList -}}
{{ end -}}
{{ $pathList = joinPath .chezmoi.homeDir ".local/bin" | prepend $pathList -}}
{{ $pathList = joinPath .chezmoi.homeDir ".local/share/mise/shims" | prepend $pathList -}}
PATH = '{{ $pathList | uniq | join .chezmoi.pathListSeparator }}'
PYTHONPYCACHEPREFIX = '{{ joinPath .chezmoi.homeDir ".cache/python" }}'
UV_PROJECT = '{{ .chezmoi.workingTree }}'
XDG_CACHE_HOME = '{{ joinPath .chezmoi.homeDir ".cache" }}'
XDG_CONFIG_HOME = '{{ joinPath .chezmoi.homeDir ".config" }}'
XDG_DATA_HOME = '{{ joinPath .chezmoi.homeDir ".local/share" }}'
XDG_STATE_HOME = '{{ joinPath .chezmoi.homeDir ".local/state" }}'

[github]
refreshPeriod = "5m"

[interpreters.py]
command = "mise"
args = ["exec", "uv", "--", "uv", "run", "--no-dev"]
