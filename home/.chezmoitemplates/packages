{{ $packageManager := index .packageManagers .distro -}}
{{ $finalPackages := list -}}

{{ $isNotContainer := not (env "container") -}}
{{ $filters := dict
     "__kvmGuest__" (and ($isNotContainer) (contains "Standard PC" .productName))
     "__oracleGuest__" (and ($isNotContainer) (eq "VirtualBox" .productName))
     "__gui__" (.manageGui)
     "__gnome__" (and (.manageGui) (.installGnome))
-}}

{{ range $package, $overrides := .packages -}}
{{   if kindIs "invalid" $overrides -}}
{{     $finalPackages = append $finalPackages $package }}{{ continue -}}
{{   end -}}
{{   $skip := false -}}
{{   range $filter, $value := $filters -}}
{{     if and (hasKey $overrides $filter) (not $value) }}{{ $skip = true }}{{ end -}}
{{   end -}}
{{   if $skip }}{{ continue }}{{ end -}}
{{   if hasKey $overrides $packageManager -}}
{{     $package = index $overrides $packageManager -}}
{{   else if hasKey $overrides "*" -}}
{{     $package = index $overrides "*" -}}
{{   end -}}
{{   $package = $package | default "" -}}
{{   $finalPackages = concat $finalPackages (splitList " " $package) -}}
{{ end -}}

{{ compact $finalPackages | sortAlpha | join " " -}}
