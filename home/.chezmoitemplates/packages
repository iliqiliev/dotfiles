{{ $packageManager := index .packageManagers .distro -}}
{{ $finalPackages := list -}}

{{ $isNotContainer := not (env "container") -}}
{{ $filters := dict
           "alpine" (.distro | eq "alpine")
             "arch" (.distro | eq "arch")
            "gnome" (.manageGnome)
              "gui" (.manageGui)
        "kvm-guest" ($isNotContainer | and (.productName | contains "Standard PC"))
            "linux" (.os | eq "linux")
          "no-work" (not .isWork)
     "oracle-guest" ($isNotContainer | and (.productName | eq "VirtualBox"))
          "windows" (.os | eq "windows")
-}}

{{ range $package, $overrides := .packages -}}
{{   if kindIs "invalid" $overrides -}}
{{     $finalPackages = append $finalPackages $package -}}
{{     continue -}}
{{   end -}}
{{   range $tag := (index $overrides "__tags__") -}}
{{     if not (index $filters $tag) -}}
{{       $package = false -}}
{{       break -}}
{{     end -}}
{{   end -}}
{{   if not $package -}}
{{     continue -}}
{{   end -}}
{{   $package = index $overrides $packageManager | default $package -}}
{{   $finalPackages = $package | splitList " " | concat $finalPackages -}}
{{ end -}}

{{ compact $finalPackages | sortAlpha | join " " -}}
