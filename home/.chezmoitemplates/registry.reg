Windows Registry Editor Version 5.00

; Set keyboard layouts.
[HKEY_CURRENT_USER\Keyboard Layout\Preload]
{{ if .isPersonal -}}
; English (US)
"1"="00000409"
; Bulgarian (Phonetic Traditional)
"2"="00040402"
{{ end -}}

; Disable mouse acceleration.
[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"

; Restore the classic context menu in Windows 11.
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
; Free Super+V shortcut for external clipboard manager.
"DisabledHotkeys"="V"
; Show hidden files and folders in explorer.
"Hidden"=dword:00000001
; Show file extensions in explorer.
"HideFileExt"=dword:00000000
; Align taskbar to the left.
"TaskbarAl"=dword:00000000

; Add 'End task' button when right-clicking a program.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings]
"TaskbarEndTask"=dword:00000001

; Change the app opened by the `CALC` key.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AppKey\18]
"ShellExecute"="qalculate-gtk"

; Hide 'Learn about this picture' icon.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel]
"{2cc5ca98-6485-489a-920e-b3e88a6ccce3}"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run]
; Autostart `AltSnap`. Written like this to be adopted by AltSnap's GUI.
{{ $altSnap := joinPath .chezmoi.homeDir "scoop/apps/altsnap/current/AltSnap.exe" -}}
"AltSnap"={{ print `"` $altSnap `"` | quote }}
; Autostart `Ditto`.
{{ $ditto := joinPath .chezmoi.homeDir "scoop/apps/ditto/current/Ditto.exe" -}}
"Ditto"={{ print `"` $ditto `"` | quote }}

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
; Disable Bing in Start search.
"BingSearchEnabled"=dword:00000000
; Hide the taskbar search box.
"SearchboxTaskbarMode"=dword:00000000
