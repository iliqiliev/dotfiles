#!/usr/bin/env bash
# shellcheck disable=2016

set -eu

if test $# -ne 3 && test $# -ne 4; then
    echo "Usage: fish_version MAJOR MINOR PATCH [PATH]" >&2
    exit 2
fi

fish=${4:-$(command -v fish)}

if test -z "$fish"; then
    echo "Error: fish shell is not installed." >&2
    exit 127
fi

IFS="." read -r -a version_array <<<"$($fish -c 'echo $FISH_VERSION')"

if test ${#version_array[@]} -ne 3; then
    exit 1
fi

major=$1 minor=$2 patch=$3

if ((version_array[0] > major)); then
    exit 0
elif ((version_array[0] < major)); then
    exit 1
fi

if ((version_array[1] > minor)); then
    exit 0
elif ((version_array[1] < minor)); then
    exit 1
fi

((version_array[2] >= patch))
