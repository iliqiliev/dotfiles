{{- if or
    (ne .os "linux")
    (not (lookPath "fish"))
    (exec "fish" "-c" "test (echo $FISH_VERSION | awk -F '.' '{print $1}') -ge 4")
}}
{{-   abortEmpty }}
{{- end }}

{{- $fish := printf "fish-*-linux-%s.tar.xz" (output "uname" "--machine" | trim) -}}

["fish"]
type = "archive-file"
path = "fish"
executable = true
url = {{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" $fish | quote }}
refreshPeriod = "672h"
