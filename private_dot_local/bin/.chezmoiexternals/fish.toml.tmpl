{{- /* Do not install if not Linux or "status build-info" fails (added in fish v4.0.0) */}}
{{- if or (ne .os "linux") (exec "sh" "-c" "fish -c 'status build-info'") }}
{{-   abortEmpty }}
{{- end }}

{{- $fish := printf "fish-*-linux-%s.tar.xz" (output "uname" "--machine" | trim) -}}

["fish"]
type = "archive-file"
path = "fish"
executable = true
url = {{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" $fish | quote }}
refreshPeriod = "672h"
