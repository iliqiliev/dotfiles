{{- if ne .os "linux" }}
{{-   abortEmpty }}
{{- end }}

{{- $VersionCheckCmd := "test (echo $FISH_VERSION | awk -F '.' '{print $1}') -ge 4" }}
{{- if and (lookPath "fish") (exec "fish" "-c" $VersionCheckCmd) }}
{{-   abortEmpty }}
{{- end }}

{{- $fish := printf "fish-*-linux-%s.tar.xz" (output "uname" "--machine" | trim) -}}

["fish"]
type = "archive-file"
path = "fish"
executable = true
url = {{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" $fish | quote }}
refreshPeriod = "672h"
