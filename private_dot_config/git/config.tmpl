[user]
    email = {{ .email | quote }}
    name = {{ .name | quote }}

[core]
    autocrlf = false
    eol = lf
{{- if lookPath "delta" }}
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

{{- end }}

[merge]
    conflictstyle = diff3

{{- if lookPath "gh" }}

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

{{- end }}
