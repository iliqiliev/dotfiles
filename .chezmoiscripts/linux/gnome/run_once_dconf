#!/usr/bin/env bash

set -eu

# shellcheck source=.chezmoi/env.sh
source ~/.local/share/chezmoi/.chezmoi/env.sh

function dconf_append {
    key="$1" && shift
    current=$(dconf read "$key")
    current=$(echo "${current:-"[]"}" | tr "'" '"')

    if ! command -v jq >/dev/null; then
        print_red "'jq' is not installed, cannot append '$*' to '$key'"
        return
    fi

    updated=$(jq '$current + ($ARGS.positional | map(. + ".desktop")) | unique' \
        --argjson current "$current" --args "$@" --null-input)

    dconf write "$key" "$(echo "$updated" | tr '"' "'")"
}

print_blue "Setting Dconf settings..."

if test "$CHEZ_IS_PERSONAL" = "true"; then
    dconf write /org/gnome/desktop/input-sources/sources \
        "[('xkb', 'us'), ('xkb', 'bg+phonetic')]"

    dconf write /org/gnome/shell/favorite-apps \
        "['zen.desktop', 'kitty.desktop', 'dev.zed.Zed.desktop']"
fi

INPUT_SOURCES=/org/gnome/desktop/input-sources
dconf write $INPUT_SOURCES/per-window true

INTERFACE=/org/gnome/desktop/interface
dconf write $INTERFACE/gtk-enable-primary-paste false
dconf write $INTERFACE/gtk-theme "'adw-gtk3'"
dconf write $INTERFACE/icon-theme "'Morewaita'"

MOUSE=/org/gnome/desktop/peripherals/mouse
dconf write $MOUSE/accel-profile "'flat'"

KEYBOARD=/org/gnome/desktop/peripherals/keyboard
dconf write $KEYBOARD/numlock-state true

WM_KEYBINDINGS=/org/gnome/desktop/wm/keybindings
dconf write $WM_KEYBINDINGS/panel-run-dialog "['<Super>r']"
dconf write $WM_KEYBINDINGS/show-desktop "['<Super>d']"
dconf write $WM_KEYBINDINGS/switch-input-source "['<Alt>Shift_L']"
dconf write $WM_KEYBINDINGS/switch-input-source-backward "['<Shift>Alt_L']"

WM_PREFERENCES=/org/gnome/desktop/wm/preferences
dconf write $WM_PREFERENCES/action-middle-click-titlebar "'minimize'"
dconf write $WM_PREFERENCES/mouse-button-modifier "'<Super>'"
dconf write $WM_PREFERENCES/resize-with-right-button true

MUTTER=/org/gnome/mutter
dconf write $MUTTER/attach-modal-dialogs false

MEDIA_KEYS=/org/gnome/settings-daemon/plugins/media-keys
dconf write $MEDIA_KEYS/help "['']"
dconf write $MEDIA_KEYS/home "['<Super>e']"
dconf write $MEDIA_KEYS/logout "['<Shift><Super>l']"
dconf write $MEDIA_KEYS/mic-mute "['Scroll_Lock']"
dconf write $MEDIA_KEYS/reboot "['<Control><Alt>Delete']"
dconf write $MEDIA_KEYS/shutdown "['<Shift><Control><Alt>Delete']"
dconf write $MEDIA_KEYS/volume-step 5

SHELL=/org/gnome/shell
dconf write $SHELL/always-show-log-out true
dconf write $SHELL/disable-extension-version-validation true
dconf write $SHELL/keybindings/toggle-message-tray "['']"
dconf write $SHELL/keybindings/screenshot "['Print']"
dconf write $SHELL/keybindings/screenshot-window "['<Super>Print']"
dconf write $SHELL/keybindings/show-screenshot-ui "['<Shift><Super>s']"
dconf write $SHELL/welcome-dialog-last-shown-version "67.0"

SHELL_EXTENSIONS=/org/gnome/shell/extensions

## App Hider
HIDDEN_APPS=(
    avahi-discover bssh btop bvnc lstopo nvim org.gnome.Settings
    org.gnome.Extensions scrcpy scrcpy-console qv4l2 qvidcap yazi
)
dconf_append $SHELL_EXTENSIONS/app-hider/hidden-apps "${HIDDEN_APPS[@]}"

## Copyous
dconf write $SHELL_EXTENSIONS/copyous/open-clipboard-dialog-shortcut "['<Super>v']"
dconf write $SHELL_EXTENSIONS/copyous/sound "'message'"

print_green "Dconf configured successfully."
