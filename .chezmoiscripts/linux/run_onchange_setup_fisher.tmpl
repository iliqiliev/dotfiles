#!{{ lookPath "fish" }}

# fisher_plugins hash: {{ include (joinPath .chezmoi.homeDir ".config/fish/fish_plugins") | sha256sum }}

if not type --query "fisher"
    if not curl -sL git.io/fisher | source
        set_color red
        echo "Failed to install fisher." >&2
        set_color normal
        exit 0
    end
end

echo "Installing fish plugins..."
fisher update > /dev/null

set_color green
echo "Installed $(count (fisher list)) fish plugins."
set_color normal
