{{ if eq .distro "debian" -}}

#!/usr/bin/env bash

# packages.yaml hash: {{ .packages.apt | toString | sha256sum }}

{{ .sudo }} apt update -y
AVAILABLE_PACKAGES=$(
  comm -12 \
    <(apt-cache pkgnames | sort) \
    <(echo -e "{{ join "\\n" .packages.apt }}" | sort)
)
{{ .sudo }} apt install -y $AVAILABLE_PACKAGES

{{- end }}
