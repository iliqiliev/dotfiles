{{ if eq .chezmoi.osRelease.id "arch" -}}

#!/usr/bin/env bash

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
echo "Running on an Arch-based distro: {{ .chezmoi.osRelease.id }}"

if [[ $EUID -ne 0 ]]; then
    SUDO_CMD="sudo"
fi

$SUDO_CMD pacman -Sy --needed --noconfirm {{ join " " .packages.pacman }}

{{- end }}
