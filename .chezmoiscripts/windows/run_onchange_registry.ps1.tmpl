Write-Host "Setting registry settings." -ForegroundColor Blue

{{ range (glob (joinPath .chezmoi.sourceDir "data/regedit/*.reg")) -}}

# {{ base . }} hash: {{ include . | sha256sum }}
Write-Host "Importing {{ base . }}" -ForegroundColor Blue
