{{ $month := "672h" | quote -}}
{{ $fishVersionCheck := joinPath .chezmoi.sourceDir "private_dot_local/bin/executable_fish_version_check" -}}

{{ if and (eq .os "linux") (not (exec "bash" $fishVersionCheck "4" "0" "0")) }}
{{   $arch := output "uname" "--machine" | trim -}}
[".local/bin/fish"]
    type = "archive-file"
    path = "fish"
    executable = true
    url = {{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" (printf "fish-*-linux-%s.tar.xz" $arch) | quote}}
    refreshPeriod = {{ $month }}
{{ end }}

[".config/fish/functions/fisher.fish"]
    type = "file"
    url = "https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish"

[".config/zen/profile/extensions/{9063c2e9-e07c-4c2c-9646-cfe7ca8d0498}.xpi"]
    type = "file"
    url = "https://addons.mozilla.org/firefox/downloads/latest/old-reddit-redirect/latest.xpi"

[".config/zen/profile/extensions/uBlock0@raymondhill.net.xpi"]
    type = "file"
    url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"

["AppData/Local/clink/zoxide.lua"]
    type = "file"
    url = "https://raw.githubusercontent.com/shunsambongi/clink-zoxide/master/zoxide.lua"
    refreshPeriod = {{ $month }}
