#!/usr/bin/env bash

set -eu

export RED="\033[31m"
export GREEN="\033[32m"
export YELLOW="\033[33m"
export NORMAL="\033[0m"

export PATH=$PATH:~/.local/bin

for util in sort find grep; do
    if [ "$(readlink -f $(command -v "$util"))" = "$(command -v busybox)" ]; then
        echo "Please install fully-featured utils!"
        echo "Example for Alpine: 'apk add --force-overwrite coreutils findutils grep'."
        false
    fi
done

BOOTSTRAP_D="${BASH_SOURCE[0]}.d"

declare -a bootstraps

while IFS= read -r bootstrap; do
    if [[ -x "$bootstrap" && ! "$bootstrap" =~ "##" && ! "$bootstrap" =~ ~$ ]]; then
        bootstraps+=("$bootstrap")
    fi
done < <(find -L "$BOOTSTRAP_D" -type f | sort)

for bootstrap in "${bootstraps[@]}"; do
    if ! "$bootstrap"; then
        echo -ne $RED
        echo "Error: bootstrap '$bootstrap' failed" >&2
        echo -ne $NORMAL
        exit 1
    fi
done
