<% if [[ $YADM_USER =~ ^(iliq|iliya)$ ]]; then -%>
[user]
    name = Iliya Iliev
    email = iliq0000@proton.me
    username = iliqiliev

<% fi -%>
<% if command -v delta &> /dev/null; then -%>
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

<% fi -%>
[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
