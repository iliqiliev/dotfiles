#!/usr/bin/env bash

# This is an associative array, a feature introduced in Bash 4.
# Syntax:
# [Executable name]=[Package name]

declare -A PACKAGES=(
    [delta]=git-delta
    [tldr]=tealdeer
    [yadm]=yadm
    [fish]=fish
    [micro]=micro
    [eza]=eza
    [bat]=bat
    [zoxide]=zoxide
    [fastfetch]=fastfetch
    [yazi]=yazi
    [btop]=btop
    [fzf]=fzf
)

for package in ${!PACKAGES[@]}; do
    if command -v $package > /dev/null 2>&1; then
        unset PACKAGES[${package}]
    fi
done
