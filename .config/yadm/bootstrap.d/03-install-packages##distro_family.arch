#!/usr/bin/env bash

source $(dirname ${BASH_SOURCE[0]})/00-packages

if (( ${#PACKAGES[@]} == 0 )); then
    exit 0
fi

if command -v sudo &> /dev/null &&
   groups | grep --quiet --word-regexp --extended-regexp "sudo|wheel"
then
    echo "Enter your password to install the following packages"
    echo -ne $GREEN
    echo ${PACKAGES[@]}
    echo -ne $NORMAL
    sudo --reset-timestamp pacman -Sy --needed --noconfirm ${PACKAGES[@]} || true
else
    echo -ne $RED
    echo "Failed to install packages! Check if you are a valid sudoer."
    echo -ne $NORMAL
fi


