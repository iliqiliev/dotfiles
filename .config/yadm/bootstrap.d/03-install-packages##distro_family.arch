#!/usr/bin/env bash

source "$(dirname ${BASH_SOURCE[0]})"/00-packages

function install_arch_packages() {
    if groups | grep --quiet --word-regexp --extended-regexp "sudo|wheel"; then
        echo "Enter your password to install the following packages:"
        echo -e "${GREEN}${PACKAGES[*]}${NORMAL}"
        sudo --reset-timestamp pacman -Sy --needed --noconfirm "${PACKAGES[@]}"
        true
    else
        echo -e "${RED}Failed to install packages! Check if you are a valid sudoer.${NORMAL}"
    fi
}

function add_chaotic_aur() {
    function add_chaotic_aur_root() {
        pacman-key  --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
        pacman-key --lsign-key 3056513887B78AEB
        pacman -U --noconfirm "https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst"
        pacman -U --noconfirm "https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst"

        if ! grep --quiet "chaotic-aur" /etc/pacman.conf; then
            echo -e "\r\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist" >> /etc/pacman.conf
        fi

        pacman -Sy
    }
    export -f add_chaotic_aur_root


    echo "Installing Chaotic-AUR..."
    sudo su -c "$(declare -f add_chaotic_aur_root); add_chaotic_aur_root"
    echo -e "${GREEN}Chaotic-AUR installed succesfully.${NORMAL}"

}


if (( ${#PACKAGES[@]} > 0 )); then
    install_arch_packages
fi

read -p "Install Chaotic-AUR? [y/N]: " -r -s -N 1 CHAOTIC_REPLY; echo

case ${CHAOTIC_REPLY,,} in
    y) add_chaotic_aur;;
    *) echo "Skipping Chaotic-AUR installation.";;
esac
