#!/usr/bin/env bash

if command -v sudo > /dev/null 2>&1 &&
   groups | grep --quiet --word-regexp --extended-regexp "sudo|wheel"
then
    sudo pacman -S --needed --noconfirm ${!PACKAGES[@]}
else
    echo -ne $RED
    echo "Failed to install packages! Check if you are a valid sudoer."
    echo -ne $NORMAL
fi
