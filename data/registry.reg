Windows Registry Editor Version 5.00


[HKEY_CURRENT_USER\Control Panel\Mouse]
; Disable mouse acceleration
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"

[HKEY_CURRENT_USER\Environment]
; Set path to bat's config file
"BAT_CONFIG_PATH"="%USERPROFILE%\\.config\\bat\\config"
; Set XDG config folder to allow some apps to use it instead of AppData
"XDG_CONFIG_HOME"="%USERPROFILE%\\.config"


[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}]
; Restore the classic context menu in Windows 11 (1/2)
@=""
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
; Restore the classic context menu in Windows 11 (2/2)
@=""


[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
; Disables Super+V shortcut so that another clipboard manager (Ditto) can use it.
"DisabledHotkeys"="V"
; Align the taskbar to the left
"TaskbarAl"=dword:0


[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel]
; Hide the 'Learn about this picture' icon from the desktop
"{2cc5ca98-6485-489a-920e-b3e88a6ccce3}"=dword:1


[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders]
; Make PowerShell load its profile from AppData instead of Documents
"Personal"="%APPDATA%"
