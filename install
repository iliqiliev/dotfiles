#!/bin/sh

if ! type -P git > /dev/null; then
  echo "Git is not installed. Please install Git before running this script."
  exit 1
fi

curl --create-dirs -fLo ~/.cache/yadm https://github.com/yadm-dev/yadm/raw/master/yadm
chmod +x ~/.cache/yadm

~/.cache/yadm clone https://github.com/iliqiliev/dotfiles.git --bootstrap
