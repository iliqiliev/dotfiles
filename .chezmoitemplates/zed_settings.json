{
  "$schema": "zed://schemas/settings",
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
      "enable_thinking": false,
    },
  },
  "auto_install_extensions": {
    // default
    "html": true,
    // custom
    "adwaita": true,
    "ini": true,
    "toml": true,
    "xml": true,
  },
  "auto_update": false,
  "colorize_brackets": true,
  "file_types": {
    "ini": ["*.reg"],
    "JSONC": [
      // default
      "**/.zed/**/*.json",
      "**/zed/**/*.json",
      "**/Zed/**/*.json",
      "**/.vscode/**/*.json",
      // custom
      "**/zed*.json",
    ],
  },
  "file_scan_exclusions": [
    // default
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // custom
    "**/__pycache__",
  ],
  "git_panel": {
    "tree_view": true,
  },
  "project_panel": {
    "hide_root": true,
  },
  "languages": {
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "4"],
        },
      },
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "system",
    "light": "Adwaita Light",
    "dark": "Adwaita Dark",
  },
  "wrap_guides": [80, 88],
}
