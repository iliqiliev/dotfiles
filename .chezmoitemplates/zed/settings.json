{
  "$schema": "zed://schemas/settings",

  // Fonts.
  "buffer_font_size": 20.0,
  "buffer_font_family": "Adwaita Mono",
  "ui_font_size": 20.0,
  "ui_font_family": "UbuntuMono Nerd Font",

  // Look & feel.
  "colorize_brackets": true,
  "theme": { "mode": "system", "light": "Adwaita Light", "dark": "Adwaita Dark" },
  "wrap_guides": [80, 88], // line length indicators

  // Extensions.
  "auto_install_extensions": {
    // Extensions: default
    "html": true,
    // Extensions: custom
    "adwaita": true,
    "basher": true,
    "fish": true,
    "ini": true,
    "lua": true,
    "powershell": true,
    "tcl": true,
    "toml": true,
    "xml": true,
  },

  // Disable auto-updates & telemetry.
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Linux <3 specific!
  "middle_click_paste": false,

  // Detect more files types correctly.
  "file_types": {
    "Go Text Template": ["*.tmpl"],
    "ini": ["*.reg", "*.ini.tmpl", "**/*flatpak/overrides/*"],
    "PowerShell": ["*.ps1.tmpl"],
    "Shell Script": ["*.sh.tmpl"],
    "TOML": ["*.toml.tmpl"],
  },

  // Languages & formatting.
  "languages": {
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "4"],
        },
      },
    },
    "TCL": {
      "formatter": {
        "external": {
          "command": "tclfmt",
          "arguments": ["{buffer_path}", "--indent", "4"],
        },
      },
    },
  },
  "preferred_line_length": 88,

  // Hide unnecessary files from file dock.
  "file_scan_exclusions": [
    // Exclusions: default
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // Exclusions: custom
    "**/.ruff_cache",
    "**/__pycache__",
  ],

  // Version control.
  "git_panel": {
    "sort_by_path": true,
    "tree_view": true,
  },

  // Artificial intelligence.
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
      "enable_thinking": false,
    },
    "default_profile": "ask",
  },
}
