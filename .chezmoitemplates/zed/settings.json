{
  "$schema": "zed://schemas/settings",
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
      "enable_thinking": false,
    },
    "default_profile": "ask",
  },
  "auto_install_extensions": {
    // default
    "html": true,
    // custom
    "adwaita": true,
    "basher": true,
    "fish": true,
    "ini": true,
    "lua": true,
    "powershell": true,
    "toml": true,
    "xml": true,
  },
  "auto_update": false,
  "colorize_brackets": true,
  "file_types": {
    "Go Text Template": ["*.tmpl"],
    "ini": ["*.reg", "*.ini.tmpl", "**/*flatpak/overrides/*"],
    "PowerShell": ["*.ps1.tmpl"],
    "Shell Script": ["*.sh.tmpl"],
    "TOML": ["*.toml.tmpl"],
  },
  "file_scan_exclusions": [
    // default
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // custom
    "**/.ruff_cache",
    "**/__pycache__",
  ],
  "git_panel": {
    "sort_by_path": true,
    "tree_view": true,
  },
  "preferred_line_length": 88,
  "project_panel": {
    "hide_root": true,
  },
  "languages": {
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "4"],
        },
      },
    },
    "TCL": {
      "formatter": {
        "external": {
          "command": "tclfmt",
          "arguments": ["{buffer_path}", "--indent", "4"],
        },
      },
    },
    "TOML": {
      "tab_size": 2,
    },
  },
  "middle_click_paste": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "system",
    "light": "Adwaita Light",
    "dark": "Adwaita Dark",
  },
  "wrap_guides": [80, 88],
}
